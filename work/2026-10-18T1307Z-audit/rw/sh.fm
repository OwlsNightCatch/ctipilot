sectors: []
entities: []
techniques: [T1190, T1078, T1059.007, T1555.003]
affected_products: ["SimpleHelp"]
cves:
  - id: CVE-2026-48558
    cvss: "10.0 (CVSS 3.1); 9.5 (CVSS 4.0)"
    epss: null
    type: auth-bypass
    vector: zero-click
    auth: pre-auth
    status:
      - exploited
      - cisa-kev
      - patch-available
    affected: "SimpleHelp 5.5.15 and earlier and some 6.0 pre-releases, on servers with an OIDC Authentication Service and a technician group that allows group-authenticated logins"
    fixed: "5.5.16 (build 20260526); 6.0 RC2"
