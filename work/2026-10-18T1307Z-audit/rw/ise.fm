  - rce
  - info-disclosure
  - patch-available
regions:
  - global
sectors: []
entities: []
techniques: [T1190, T1059]
affected_products: ["Cisco Identity Services Engine", "Cisco ISE Passive Identity Connector"]
cves:
  - id: CVE-2026-20181
    cvss: "9.1"
    epss: null
    type: rce
    vector: zero-click
    auth: admin-required
    status:
      - patch-available
    affected: "ISE and ISE-PIC 3.1, 3.2, 3.3, 3.4 and 3.5"
    fixed: "3.1 Patch 12, 3.2 Patch 11, 3.3 Patch 11, 3.4 Patch 6, 3.5 Patch 4 (a hot patch for 3.5 Patch 3 through TAC)"
  - id: CVE-2026-20190
    cvss: "7.5"
    epss: null
    type: info-disclosure
    vector: zero-click
    auth: pre-auth
    status:
      - patch-available
    affected: "ISE and ISE-PIC 3.4 and 3.5; 3.3 and earlier not vulnerable"
    fixed: "3.4 Patch 6, 3.5 Patch 3"
