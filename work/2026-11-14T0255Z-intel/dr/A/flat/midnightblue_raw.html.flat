<!DOCTYPE html><!-- Last Published: Wed Nov 11 2026 19:22:41 GMT+0000 (Coordinated Universal Time) --><html data-wf-domain="www.midnightblue.nl" data-wf-page="6af2d9d8bb316b0a5d6b140f" data-wf-site="64a2900ed5e9bb672af9b2ed"><head><meta charset="utf-8"/><link href="https://cdn.prod.website-files.com" rel="preconnect" crossorigin="anonymous"/><title>Don&#x27;t bother patching: multiple remote code execution vulnerabilities in Danfoss AK-SM800A</title><meta content="Following up on the waves of cyber attacks against internet-exposed fridge controllers, this blogpost argues to not waste time patching vulnerabilities on these devices by showing how we found several pre-authentication remote code execution 0-day vulnerabilities in the Danfoss AK-SM 800A in less than an hour with casual manual inspection. Instead, we recommend prioritizing reducing exposure." name="description"/><meta content="Don&#x27;t bother patching: multiple remote code execution vulnerabilities in Danfoss AK-SM800A" property="og:title"/><meta content="Following up on the waves of cyber attacks against internet-exposed fridge controllers, this blogpost argues to not waste time patching vulnerabilities on these devices by showing how we found several pre-authentication remote code execution 0-day vulnerabilities in the Danfoss AK-SM 800A in less than an hour with casual manual inspection. Instead, we recommend prioritizing reducing exposure." property="og:description"/><meta content="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/6af2dbc514f7d4ff50318021_Blue-Steel%20Broken%20Sea%20Ice%20Mosaic.png" property="og:image"/><meta content="Don&#x27;t bother patching: multiple remote code execution vulnerabilities in Danfoss AK-SM800A" name="twitter:title"/><meta content="Following up on the waves of cyber attacks against internet-exposed fridge controllers, this blogpost argues to not waste time patching vulnerabilities on these devices by showing how we found several pre-authentication remote code execution 0-day vulnerabilities in the Danfoss AK-SM 800A in less than an hour with casual manual inspection. Instead, we recommend prioritizing reducing exposure." name="twitter:description"/><meta content="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/6af2dbc514f7d4ff50318021_Blue-Steel%20Broken%20Sea%20Ice%20Mosaic.png" name="twitter:image"/><meta property="og:type" content="website"/><meta content="summary_large_image" name="twitter:card"/><meta content="width=device-width, initial-scale=1" name="viewport"/><link href="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/css/midnightblue.webflow.shared.e3a58849f.css" rel="stylesheet" type="text/css" integrity="sha384-46WISfjPCL4hjzoafd/2U99L2UVLsyKyWc1Vn1M3bvls7+rqoiKldH+2NDvpmkqc" crossorigin="anonymous"/><link href="https://fonts.googleapis.com" rel="preconnect"/><link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous"/><script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script><script type="text/javascript">WebFont.load({ google: { families: ["Open Sans:300,300italic,400,400italic,600,600italic,700,700italic,800,800italic","Poppins:300,400,500,600,700"] }});</script><script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script><link href="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2928ba843a3c5c35b1ab6_midnightblue%20favicon.png" rel="shortcut icon" type="image/x-icon"/><link href="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a29292e7f60775e38b9b38_midnightblue%20webclip.png" rel="apple-touch-icon"/><script src="https://www.google.com/recaptcha/api.js" type="text/javascript"></script><style type="text/css"> /* Styles not to be applied in Designer */ .cursor-wrap { position: fixed; top: 0; left: 0; pointer-events: none; z-index:9999; mix-blend-mode: difference; } /* Hide scrollbars wherever supported */ body { -ms-overflow-style: none; /* IE and Edge */ scrollbar-width: none; /* Firefox */ overscroll-behavior-y: none; /* Disable 'bounce back' and other browser effects upon scrolling past page end */ } html::-webkit-scrollbar, body::-webkit-scrollbar { display: none; /* Webkit */ width: 0; /* Chromium */ } /* Override placement of nav button to compensate for scrollbar width * We probably can remove this, unless if in some configuration the scroll bar is still shown. * We leave it just in case, since if the scroll bar is hidden, calc() will just compute 9.6vw. */ @media (min-width: 991px) { .button.navbutton { right: calc(9.6vw - (100vw - 100%)); } } .cursor { position: fixed; top: -30px; left: -30px; z-index:9999; } .grow { transform:scale(5) !important; opacity:.2; } .circle { transform: scale(0.8); transition: all 0.35s ease-in-out; z-index:9999; } @media (max-width: 1281px) { .cursor-wrap { display:none !important; } .cursor { display:none !important; } .circle { display:none !important; } } </style></head><body class="body-white"><div class="general-css w-embed"><style type="text/css"> * { text-rendering: optimizeLegibility; -moz-osx-font-smoothing: grayscale; font-smoothing: antialiased; -webkit-font-smoothing: antialiased; } @media only screen and (min-width: 991px) { .nav, .scrollbar { mix-blend-mode:difference; } } /* Hide scrollbar for Chrome, Safari and Opera */ body::-webkit-scrollbar { display: none; } /* Hide scrollbar for IE, Edge and Firefox */ body { -ms-overflow-style: none; /* IE and Edge */ scrollbar-width: none; /* Firefox */ } @media only screen and (min-width: 991px) { .service-item:nth-child(3n+3) > .absolute-service-image { display:block !important; } } /* Hide scrollbar for Chrome, Safari and Opera */ .anchors-list::-webkit-scrollbar { display: none; } /* Hide scrollbar for IE, Edge and Firefox */ .anchors-list { -ms-overflow-style: none; /* IE and Edge */ scrollbar-width: none; /* Firefox */ } @media only screen and (min-width: 1700px) { .menu-text, .button, .paragraph { font-size:.7vw; } .navbutton { top:1.8vw !important; } .menu-items { padding: .25vw 1.75vw .25vw 10.5vw; } .search-wrapper { right:17.5vw; } } /* Zigzag text/img listings */ @media only screen and (min-width: 991px) { .zigzag-item:nth-child(even) > .zigzag-image { order:-1 !important; } } </style></div><div class="scrollbar"><div class="scrollbar-indicator"></div></div><div id="top" class="nav"><div class="container hspread in-nav"><a href="/" class="logo-link w-inline-block"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2a0979af1f6039e015fa6_midnightblue-logo-white.svg" loading="lazy" alt="Midnight Blue" class="c-logo_white"/></a><form action="/search" class="search-wrapper w-form"><div data-w-id="e8e0afa3-fc61-6551-4833-94f7a1d30e09" class="search-trigger"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/686cc62aad0aceac5f23fe46_magnifier%202.svg" loading="lazy" alt="" class="magnifier-mobile"/></div><div class="search-input-wrap"><input class="search-input w-input" maxlength="256" name="query" placeholder="Enter search query" type="search" id="search" required=""/><input type="submit" class="hidden-submit button w-button" value="Search"/><div class="magnifier-wrapper"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/686cc62aad0aceac5f23fe46_magnifier%202.svg" loading="lazy" alt="" class="magnifier"/></div></div></form><div class="menu-items"><div class="div-block"><div data-w-id="5352f572-d7e1-678b-de2b-ce77feedf2eb" data-is-ix2-target="1" class="hamburger first" data-animation-type="lottie" data-src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2cead08e32f68f5834bb1_Comp%201.json" data-loop="0" data-direction="1" data-autoplay="0" data-renderer="svg" data-default-duration="2" data-duration="0" data-loading="eager" data-ix2-initial-state="0"></div></div></div></div></div><div class="nav-open-wrapper"><div class="nav-open"><div class="nav-column noshrink"><a href="/" class="nav-link w-inline-block"><h3 class="h3 mbot-0">Home</h3></a><a href="/services" class="nav-link w-inline-block"><h3 class="h3 mbot-0">Services</h3></a><a href="/markets" class="nav-link w-inline-block"><h3 class="h3 mbot-0">Markets</h3></a><a href="/knowledge" class="nav-link hide-on-mobile w-inline-block"><h3 class="h3 mbot-0">Knowledge</h3></a><a href="/knowledge?type=Research" class="nav-link only-mobile w-inline-block"><h3 class="h3 mbot-0">Research</h3></a><a href="/knowledge?type=Cases" class="nav-link only-mobile w-inline-block"><h3 class="h3 mbot-0">Cases</h3></a><a href="/knowledge?type=Blog" class="nav-link only-mobile w-inline-block"><h3 class="h3 mbot-0">Blog</h3></a><a href="/company" class="nav-link w-inline-block"><h3 class="h3 mbot-0">Company</h3></a><a href="/contact-us" class="nav-link w-inline-block"><h3 class="h3 mbot-0">Contact</h3></a></div><div class="nav-column spread"><div class="nav-categories"><div class="nav-category"><div class="paragraph poppins dark-gray">Services</div><div class="nav-category-wrap w-dyn-list"><div role="list" class="nav-category-links w-dyn-items"><div role="listitem" class="nav-category-item w-dyn-item"><a data-w-id="4c8513d9-72ff-7024-1b2d-6636e991dc21" href="/services/systems-vulnerability-research" class="category-link w-inline-block"><div class="sub-item-line"><div class="hover-line-inner"></div></div><div class="paragraph poppins dark mbot-0">Systems &amp; vulnerability research</div></a></div><div role="listitem" class="nav-category-item w-dyn-item"><a data-w-id="4c8513d9-72ff-7024-1b2d-6636e991dc21" href="/services/capability-development" class="category-link w-inline-block"><div class="sub-item-line"><div class="hover-line-inner"></div></div><div class="paragraph poppins dark mbot-0">Capability development</div></a></div><div role="listitem" class="nav-category-item w-dyn-item"><a data-w-id="4c8513d9-72ff-7024-1b2d-6636e991dc21" href="/services/defensive-design" class="category-link w-inline-block"><div class="sub-item-line"><div class="hover-line-inner"></div></div><div class="paragraph poppins dark mbot-0">Defensive design</div></a></div></div></div></div><div class="nav-category"><div class="paragraph poppins dark-gray">Knowledge</div><div class="nav-category-links"><a data-w-id="3800f21f-892e-bb38-f38b-69005f993ec3" href="/knowledge?type=Research" class="category-link w-inline-block"><div class="sub-item-line"><div class="hover-line-inner"></div></div><div class="paragraph poppins dark mbot-0">Research</div></a><a data-w-id="3800f21f-892e-bb38-f38b-69005f993ec8" href="/knowledge?type=Cases" class="category-link w-inline-block"><div class="sub-item-line"><div class="hover-line-inner"></div></div><div class="paragraph poppins dark mbot-0">Cases</div></a><a data-w-id="3800f21f-892e-bb38-f38b-69005f993ecd" href="/knowledge?type=Blog" class="category-link w-inline-block"><div class="sub-item-line"><div class="hover-line-inner"></div></div><div class="paragraph poppins dark mbot-0">Blog</div></a></div></div></div><div class="contact-methods in-menu"><a data-w-id="3800f21f-892e-bb38-f38b-69005f993ed3" href="mailto:sales@midnightblue.nl" class="contact-method w-inline-block"><div class="arrow-container"><div class="arrow-wrapper to-left"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f2ccee1510d6f5717b738b_envelope.svg" loading="lazy" alt="" class="arrow-inner"/></div><div class="arrow-wrapper"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f2ccee1510d6f5717b738b_envelope.svg" loading="lazy" alt="" class="arrow-inner"/></div></div><p class="paragraph dark poppins medium mbot-0">sales[ ]midnightblue[ ]nl</p></a><a data-w-id="3800f21f-892e-bb38-f38b-69005f993edb" href="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64b8288f60eb4ca6ae6cd45f_sales%40midnightblue.nl-(0x9035856DF1D41F73)-public.asc.txt" target="_blank" class="contact-method w-inline-block"><div class="arrow-container"><div class="arrow-wrapper to-left"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f2cd0d6b8ca1f7d94bad55_key.svg" loading="lazy" alt="" class="arrow-inner"/></div><div class="arrow-wrapper"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f2cd0d6b8ca1f7d94bad55_key.svg" loading="lazy" alt="" class="arrow-inner"/></div></div><p class="paragraph dark poppins medium mbot-0">PGP (0x9035856DF1D41F73)</p></a></div></div></div></div><a href="/contact-us" class="button navbutton w-button">Work with us</a><div id="go-to-top" class="page-wrapper"><section id="top" class="detail-hero blog"><div class="container"><div class="padded-content"><div class="spread vertical-mobile"><div class="labels"><div data-w-id="1d7775dd-f930-2742-04d7-cc0544d317bc" class="paragraph">November, 2026</div><div class="timing"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f32a73150b858761f8cdb8_clock%20white.svg" loading="lazy" alt="Reading time" class="timing-icon"/><div class="paragraph">30 Minutes</div></div><div fs-cmsfilter-field="type" class="paragraph blue semibold as-label white-label">Blog</div></div><a data-w-id="1d7775dd-f930-2742-04d7-cc0544d317c4" href="/knowledge" class="contact-method first-mobile w-inline-block"><div class="arrow-container"><div class="arrow-wrapper to-left"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f9c88b30b39c80c94779d3_white%20arrow.svg" loading="lazy" alt="" class="arrow-inner"/></div><div class="arrow-wrapper"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f9c88b30b39c80c94779d3_white%20arrow.svg" loading="lazy" alt="" class="arrow-inner"/></div></div><p class="paragraph">Overview</p></a></div><div class="title-mask"><h1 data-w-id="1d7775dd-f930-2742-04d7-cc0544d317cd" class="h1 uppercase">Multiple remote code execution vulnerabilities in danfoss sm-800A</h1></div></div><div data-w-id="1d7775dd-f930-2742-04d7-cc0544d317cf" class="image-wrap negative"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2a86786350c0fc28bf801_bg%20img%20(1).jpg" loading="lazy" sizes="(max-width: 2484px) 100vw, 2484px" srcset="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2a86786350c0fc28bf801_bg%20img%20(1)-p-500.jpg 500w, https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2a86786350c0fc28bf801_bg%20img%20(1)-p-800.jpg 800w, https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2a86786350c0fc28bf801_bg%20img%20(1)-p-1080.jpg 1080w, https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2a86786350c0fc28bf801_bg%20img%20(1)-p-1600.jpg 1600w, https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2a86786350c0fc28bf801_bg%20img%20(1).jpg 2484w" alt="" class="image-inner parallax"/><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2a2e372d93ae04306af5f_midnightblue-logo-dark.svg" loading="lazy" alt="" class="blog-icon"/></div></div><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f9c8e9fe42e97e00f57a95_fade.svg" loading="lazy" alt="" class="fade"/><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f9c930b53f01981d9c24f4_circles.svg" loading="lazy" alt="" class="circles"/></section><section class="smoke-section as-first"><div class="container"><div class="padded-content"><div id="project" class="content-block"><h2 data-w-id="1d7775dd-f930-2742-04d7-cc0544d317d8" class="paragraph dark poppins medium gray mbot-2">Introduction</h2><div class="two-grid"><p id="w-node-_1d7775dd-f930-2742-04d7-cc0544d317db-5d6b140f" data-w-id="1d7775dd-f930-2742-04d7-cc0544d317db" class="paragraph dark">Since October 11th waves of cyber attacks have hit internet-exposed fridge controllers by Danfoss and Copeland throughout <a href="https://en.wikipedia.org/wiki/2026_European_cold_chain_hacks" target="_blank">Europe</a>, with attackers triggering defrosting operations and causing tens of millions of euros in spoilt food damages and even causing fires in some cases.<br/><br/>While, as pointed out by <a href="https://www.sentinelone.com/labs/defrost-and-disrupt-an-assessment-of-europe-s-refrigeration-attacks/" target="_blank">SentinelOne</a>, attribution remains open and analysts should be careful not to immediately assume all incidents are linked to the same threat actor, the impact of these incidents (in particular their psychological effect) is in sharp contrast to their technical simplicity.<br/></p><p id="w-node-_1d7775dd-f930-2742-04d7-cc0544d317e0-5d6b140f" data-w-id="1d7775dd-f930-2742-04d7-cc0544d317e0" class="paragraph dark">While much online commentary has correctly pointed out that these kind of controllers should not be internet-exposed, remote connectivity of some sort is often a must-have due to maintenance personnel constraints and SLA or insurance requirements.<br/><br/>As a result, many asset owners are simply content to change default credentials, apply patches for known vulnerabilities, enable <em>strict </em>level session control, and move on. <strong>This is insufficient and asset owners need to remove internet exposure as soon as possible</strong> (e.g. though use of a VPN, private APN, or highly restrictive IP whitelisting ACLs). We recommend <strong><em>against </em></strong>allocating scarce security resources to patching efforts and instead focus on reducing exposure.<br/><br/>As we will demonstrate in this blogpost, <strong>Midnight Blue researcher Carlo Meijer found several pre-authentication remote code execution 0-day vulnerabilities in the Danfoss AK-SM 800A in less than an hour with casual manual inspection.</strong></p></div></div></div></div></section><section class="white-section"><div class="container"><div class="padded-content"><div class="content-block"><div data-w-id="1d7775dd-f930-2742-04d7-cc0544d317ec" class="paragraph dark w-richtext"><h2>Background</h2><p>Prior to the attack waves which started in France on October 11th, several vulnerabilities had already been documented in multiple Danfoss product lines (AK SM-800, AK SM-800A, AK-EM100) by SynAcktiv (in 2023 [<a href="https://www.synacktiv.com/sites/default/files/2023-10/synacktiv-danfoss-sm800-sc255-sc355-auth-bypass.pdf" target="_blank">1</a>,<a href="https://www.synacktiv.com/sites/default/files/2023-10/synacktiv-danfoss-sm800a-multiple-vulnerabilities.pdf" target="_blank">2</a>]), Claroty (in 2025 [<a href="https://claroty.com/team82/research/freeze-the-controller-defrost-the-food-uncovering-vulnerabilities-in-danfoss-refrigeration-controllers" target="_blank">3</a>]), and DIVD/HackDefense (in 2023 [<a href="https://csirt.divd.nl/cases/DIVD-2023-00021/" target="_blank">4</a>]).</p><p>These vulnerabilities have included the much-discussed <em>code-of-the-day</em> authentication bypass (CVE-2025-41450), OS command injection (CVE-2023-25915, CVE-2025-41451) and path traversal (CVE-2023-25914) vulnerabilities in the AK-SM800A, as well as SQL injection (<a href="https://csirt.divd.nl/cves/CVE-2023-22583/" target="_blank">CVE-2023-22583</a>) and OS command injection (<a href="https://csirt.divd.nl/cves/CVE-2023-25911/" target="_blank">CVE-2023-25911</a>) vulnerabilities in the EOL AK-EM100.</p><p>All of these vulnerabilities are shockingly trivial to find and exploit, and the first public Proof-of-Concept (PoC) exploits were dropped within 48 hours of the French attacks [<a href="https://github.com/Nero22k/CVE-2025-41450_poc" target="_blank">5</a>, <a href="https://github.com/msuiche/fromagegate" target="_blank">6</a>] - preceding the second attack wave on November 2nd.</p><p>According to Censys, there are still hundreds of Danfoss systems exposed online (though no doubt a sizeable chunk are by now honeypots) and over a 1000 <a href="https://claroty.com/team82/research/chilling-discoveries-unpacking-vulnerabilities-in-copeland-xweb-pro-controllers" target="_blank">Copeland and Dixell</a> fridge controllers. In addition, controllers from similar vendors (such as Eliwell) which have not been targeted remain exposed in the hundreds as well.</p><figure class="w-richtext-align-center w-richtext-figure-type-image"><div><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/6af2f094072b478d2e103274_censys1.png" loading="lazy" alt=""/></div><figcaption><em>Censys search for Danfoss, Copeland/Dixell, and Eliwell systems as of 10-11-2026</em></figcaption></figure><p>‍</p><p>All this is to say that despite the demonstrable subpar security posture of these controllers and several attack waves with serious impact, controllers remain exposed to the public internet. While this is for understandable reasons (supermarket chains sometimes risk SLA or insurance condition violations by taking away remote maintenance and restricting access through VPNs isn&#x27;t a trivial systems change), <strong>we consider it of paramount importance for defenders not to fall into the trap of considering risks sufficiently mitigated by applying patches</strong> as is suggested by <a href="https://www.danfoss.com/en/service-and-support/coordinated-vulnerability-disclosure/danfoss-security-advisories/" target="_blank">Danfoss guidance</a>.</p><p>In order to demonstrate this, we investigated the <strong>latest Danfoss AK-SM800A firmware version</strong> (5.3.2 at the time of writing) and <strong>within an hour of manual investigation (no AI necessary...) uncovered 6 pre-authentication remote code execution 0-day vulnerabilities</strong>.</p><figure class="w-richtext-align-center w-richtext-figure-type-image"><div><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/6af2f427184296168d6ab8a6_ak-sm800a.jpg" loading="lazy" alt=""/></div><figcaption><em>Danfoss AK-SM800A</em></figcaption></figure><p>‍</p><p>We are currently in a coordinated vulnerability disclosure process with Danfoss and as such will withhold technical details until disclosure is sorted, but due to ongoing targeting of these controllers we consider it important asset owners have a realistic view of the overall security posture of these devices ontrollers in order to take the appropriate measures rather than rely on piecemeal patching.</p><p>‍</p><h2>Overview</h2><ul role="list"><li><strong>CVEs</strong>: Pending</li><li><a href="https://nvd.nist.gov/vuln/detail/CVE-2024-8036" target="_blank">‍</a><strong>Vendor</strong>: Danfoss</li><li><strong>Affected products: </strong>AK-SM800A</li><li><strong>Affected versions: </strong>All up to and including 5.3.2</li><li><strong>Vulnerability type: </strong>Multiple (6) stack-based buffer overflows</li><li>‍<strong>Potential impact:</strong> Full device take-over, Persistent access (possibly after reset), Persistent Denial of Service (rendering device inoperable)</li><li><p><strong>Mitigation: </strong>Restrict network exposure through VPNs, private APN, or highly restrictive IP whitelisting ACLs</p></li></ul><p>‍</p><h2>60 minutes and a firmware image</h2><h3>Initial Investigation &amp; Setup</h3><p>Danfoss AK-SM800A firmware images can be downloaded from their website and contain 7-zip compressed ARM binaries handling application logic. Danfoss AK-SM800A controllers run <a href="https://sm800a.danfoss.com/Danux_shared/" target="_blank">Danux</a>, a custom Yocto-based Linux distribution, on an i.MX6 processor.</p><p>Let&#x27;s start by setting up an emulation environment for the firmware. The path of least resistance here is emulating the binary in userland, rather than emulating the entire system including the kernel. After mounting the filesystem, we can copy qemu-armel-static in there and run the following command to be presented with a shell:</p><pre contenteditable="false" class="w-code-block" style="display:block;overflow-x:auto;background:#2b2b2b;color:#f8f8f2;padding:0.5em"><code class="language-bash" style="white-space:pre-wrap"><span><span>$ sudo chroot . /qemu-armel-static /bin/sh </span></span><span><span>sh-4.4</span><span style="color:#d4d0ab"># </span></span></code></pre><p>‍</p><p>As pointed out by <a href="https://claroty.com/team82/research/freeze-the-controller-defrost-the-food-uncovering-vulnerabilities-in-danfoss-refrigeration-controllers" target="_blank">Claroty</a>, the SM800A platform consists of an NGINX reverse proxy, a bunch of CGI handlers, and independent processes handling application logic. Requests for URLs ending with <em>.cgi</em> suffix are forwarded to a task created by the <em>sm_app</em> executable.</p><p>It turns out that <em>sm_app</em> is a huge monolithic application that is responsible for pretty much everything that happens on the device. It is more like a mini <em>Real-Time Operating System</em> (RTOS) running in a userland process (a common embedded architectural choice resulting from <em>lift-and-shift</em> platform migrations). It has a task (thread) list consisting of 52 entries, among which are <em>Task_Modbus_drv_task</em>, <em>Task_Ethernet</em>, <em>Task_IOHandler</em> and <em>Task_Web</em> to name a few. Running the sm_app in this environment that&#x27;s missing a significant chunk of the devices and drivers will almost certainly end in a crash. Applying some ad-hoc patches to the binary to avoid crashes will probably work, but potentially painful.</p><p>Fortunately, we&#x27;re only interested in Task_Web, so instead of fixing up everything, I can just LD_PRELOAD my way in the binary, let it run all the initialization code until it hits main(), hijack the code flow from there, apply some hooks which I won&#x27;t delve into here, and start the web server. It turns out that Danux conveniently ships with gcc:</p><pre contenteditable="false" class="w-code-block" style="display:block;overflow-x:auto;background:#2b2b2b;color:#f8f8f2;padding:0.5em"><code class="language-bash" style="white-space:pre-wrap"><span><span>$ gcc -shared -g -fPIC -o libpreload.so preload.c </span></span><span>$ sudo chroot . /qemu-armel-static -E LD_PRELOAD=/libpreload3.so /danfoss/sm_app </span><span>hi from hijacked code</span></code></pre><p>‍</p><p>With some additional minor fixes, we are now able to talk to the emulated web server:</p><pre contenteditable="false" class="w-code-block" style="display:block;overflow-x:auto;background:#2b2b2b;color:#f8f8f2;padding:0.5em"><code class="language-bash" style="white-space:pre-wrap"><span><span>$ curl -v -d </span><span style="color:#abe338">&#x27;&#x27;</span><span> http://127.0.0.1:8080/xml.cgi </span></span><span>* Trying 127.0.0.1:8080... </span><span>* Connected to 127.0.0.1 (127.0.0.1) port 8080 </span><span>&gt; POST /xml.cgi HTTP/1.1 </span><span>&gt; Host: 127.0.0.1:8080 </span><span>&gt; User-Agent: curl/8.5.0 </span><span>&gt; Accept: */* </span><span>&gt; Content-Length: 0 </span><span>&gt; Content-Type: application/x-www-form-urlencoded </span><span>&gt; </span><span>&lt; HTTP/1.1 200 </span><span>&lt; Date: Sat, 07 Nov 2026 21:44:33 GMT </span><span>&lt; Content-Type: text/xml </span><span>&lt; Content-Length: 75 </span><span>&lt; Connection: keep-alive </span><span>&lt; Server: Danfoss SM800A </span><span><span>&lt; Access-Control-Allow-Private-Network: </span><span style="color:#f5ab35">true</span><span> </span></span><span>&lt; Access-Control-Allow-Origin: * </span><span>&lt; Access-Control-Allow-Methods: GET, POST, OPTIONS </span><span>&lt; Access-Control-Allow-Headers: aksm-auth,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type </span><span>&lt; Cache-Control: no-store, no-cache </span><span>&lt; </span><span><span>* Connection </span><span style="color:#d4d0ab">#0 to host 127.0.0.1 left intact</span><span> </span></span><span><span>&lt;?xml version=</span><span style="color:#abe338">&quot;1.0&quot;</span><span> encoding=</span><span style="color:#abe338">&quot;utf-8&quot;</span><span>?&gt;&lt;resp error=</span><span style="color:#abe338">&quot;4&quot;</span><span>&gt;DEFAULT_STRING&lt;/resp&gt;</span></span></code></pre><p>‍</p><h3>Worrying Code Smells</h3><p>The first thing to do is get a sense of the security quality of the code base through so-called <a href="https://en.wikipedia.org/wiki/Code_smell" target="_blank">code smells</a> and anti-patterns.</p><p>The first such bad code smell is the extremely liberal use of strcpy. Use of the <em>strcpy</em>() function is discouraged as there is no size parameter. Instead, the function will keep copying bytes from the source buffer into the destination until it hits a null byte. This is a common source of memory corruption vulnerabilities in cases where the source buffer is provided by the user. Hundreds of strcpy invocations exist in the codebase which are part of externally reachable and unauthenticated handler functions. In fact, in earlier firmware releases each command handler is itself responsible for enforcing authentication, rather than doing so centrally. This needlessly enlarged the pre-authentication attack surface.</p><figure class="w-richtext-align-center w-richtext-figure-type-image"><div><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/6af303271ef3224798a94f50_xrefs1.png" loading="lazy" alt=""/></div><figcaption><em>Widespread use of strcpy in externally reachable functions</em></figcaption></figure><p>‍</p><p>Next, we check for binary security mechanisms and exploit mitigations:</p><pre contenteditable="false" class="w-code-block" style="display:block;overflow-x:auto;background:#2b2b2b;color:#f8f8f2;padding:0.5em"><code class="language-bash" style="white-space:pre-wrap"><span><span>$ checksec sm_app </span></span><span><span>[*] </span><span style="color:#abe338">&#x27;/mnt/SM800A-4.2.4/sm_app&#x27;</span><span> </span></span><span> Arch: arm-32-little </span><span> RELRO: Partial RELRO </span><span> Stack: No canary found </span><span> NX: NX enabled </span><span> PIE: No PIE (0x10000) </span><span><span> RPATH: b</span><span style="color:#abe338">&#x27;$ORIGIN:$ORIGIN/../../sm_gp_lib/Debug/:$ORIGIN/../../sm_fu_lib/Debug/:$ORIGIN/../../sm_df_lib/Debug/:$ORIGIN/../../sm_msgqueue_lib/Debug/:$ORIGIN/../../sm_lz_lib/Debug/:$ORIGIN/../../sm_tm_lib/Debug/:$ORIGIN/../../sm_up_lib/Debug/:$ORIGIN/../../sm_history_lib/Debug/:$ORIGIN/../../sm_thread_lib/Debug/:$ORIGIN/../../sm_fs_lib/Debug/:$ORIGIN/../../sm_at_lib/Debug/:$ORIGIN/../../sm_mutex_lib/Debug/:$ORIGIN/../../sm_lg_lib/Debug/:$ORIGIN/../../sm_system_lib/Debug/:$ORIGIN/../../sm_os_lib/Debug/:$ORIGIN/../../sm_ip_lib/Debug/:$ORIGIN/../../sm_dl_lib/Debug/:$ORIGIN/../../sm_db_lib/Debug/:$ORIGIN/../../sm_tk_lib/Debug/:$ORIGIN/../../sm_session_lib/Debug/&#x27;</span></span></code></pre><p>‍</p><p>It turns out that <a href="https://en.wikipedia.org/wiki/Buffer_overflow_protection#Canaries" target="_blank">stack canaries</a> and <a href="https://en.wikipedia.org/wiki/Position-independent_code#Position-independent_executables" target="_blank"><em>Position Independent Executable</em></a> (PIE) are not enabled. These mechanisms have been staples of memory corruption defenses for decades and enabling these features on a modern Linux distribution running on a modern ARM application processor requires no engineering work at all. It is simply a matter of setting the right compiler flag. Enabling these features became the default in Ubuntu 17.10 and there is simply no excuse for a network-facing application that was last updated a few months ago to not have them enabled.</p><p>What&#x27;s more worrying, is that multiple Danfoss business units (including Climate Solutions &amp; Electronic Controllers) received IEC 62443-4-1 certification for Secure Product Development Lifecycle and this is <a href="https://www.danfoss.com/en/service-and-support/fix-and-troubleshooting/cooling-installer-hub/electronic-controllers-services-faqs/cybersecurity-best-practices/" target="_blank">prominently advertised</a> as such. In addition, Danfoss explicitly mentions IEC 62443-4-2 is a guiding framework for designing cybersecurity requirements and implementing improvements. <strong>Asset owners, system integrators, and those responsible for procurement should realize exactly how little such certifications can say about the actual security posture of a product</strong>.</p><p>‍</p><figure class="w-richtext-align-center w-richtext-figure-type-image"><div><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/6af306a995432e6cdac19f57_iec62443-4-1.png" loading="lazy" alt=""/></div><figcaption><a href="https://assets.danfoss.com/approvals/latest/433667/ID503237690321-0101.pdf" target="_blank">IEC 62443-4-1 certificate</a>, covering Danfoss Climate Solutions &amp; Electronic Controllers</figcaption></figure><p>‍</p><h3>Vulnerability Discovery &amp; PoC Development</h3><p>The initial impression of Danfoss&#x27; security posture, combined with the nature of the historical vulnerabilities, is a worrying one. But to see just how bad this pans out, let&#x27;s see what can be found in no more than one hour of manually digging through the latest version of the firmware.</p><p>We could develop a harness and subject the binary to coverage-guided fuzzing. However, that constitutes serious effort, and with the impression of the code quality that I have, I&#x27;m going to simply look into random places where strcpy() is invoked instead. One of the first functions inspected turns out to be an unauthenticated endpoint for a CGI handler having a bunch of parsing logic and strcpy invocations.</p><p>While we will not disclose the exact endpoint affected, we will show it can be trivially exploited with a oneliner:</p><pre contenteditable="false" class="w-code-block" style="display:block;overflow-x:auto;background:#2b2b2b;color:#f8f8f2;padding:0.5em"><code class="language-bash" style="white-space:pre-wrap"><span><span>$ curl -v -d &lt;redacted&gt;</span><span style="color:#abe338">&quot;</span><span class="hljs-subst" style="color:#abe338">$(echo &#x27;print(</span><span class="hljs-subst" style="color:#abe338">&quot;A&quot;</span><span class="hljs-subst" style="color:#abe338">*768)</span><span style="color:#abe338">&#x27;|python)&quot;</span><span>&lt;redacted&gt; http://127.0.0.1:8080/&lt;redacted&gt;.cgi </span></span><span>* Trying 127.0.0.1:8080... </span><span>* Connected to 127.0.0.1 (127.0.0.1) port 8080 </span><span>&gt; POST /&lt;redacted&gt;.cgi HTTP/1.1 </span><span>&gt; Host: 127.0.0.1:8080 </span><span>&gt; User-Agent: curl/8.5.0 </span><span>&gt; Accept: */* </span><span>&gt; Content-Length: 888 </span><span>&gt; Content-Type: application/x-www-form-urlencoded </span><span>&gt;</span></code></pre><p>‍</p><p>This gives us a nice SEGFAULT showing we can probably hijack program control flow:</p><figure class="w-richtext-align-center w-richtext-figure-type-image"><div><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/6af30c873a54a4370371d1ab_segfault.png" loading="lazy" alt=""/></div></figure><p>‍</p><p>There&#x27;s at least 5 different vulnerabilities of this kind in just the little bit of code i inspected.</p><p>Of course, remotely triggering a crash is bad in itself, but being able to leverage the buffer overflow to obtain remote code execution is much worse. Any reasonably experienced exploit developer will agree exploiting straightforward stack-based buffer overflows on ARM Linux without exploit mitigations is very straightforward. And if they don&#x27;t, there&#x27;s probably a frontier or open weight model out there willing to help them agree.</p><p>The only challenge (if you can call it that) left to overcome is the fact that <code>strcpy()</code> stops copying bytes when it hits a null byte. If we wish to gain remote code execution, we inevitably need to write several addresses containing null bytes. Thus, we need to somehow overcome this inherent limitation of <code>strcpy() </code>and while we won&#x27;t share our approach for now <a href="https://www.youtube.com/watch?v=THNPmhBl-8I" target="_blank">it&#x27;s not exactly rocket surgery</a>. Also, the exploited application runs as root (because of course it does).</p><p>Since we have to be vague due to coordinated disclosure being ongoing, let&#x27;s at least show the result of our 100% artisanal, hand-crafted, AI and gluten free exploit in action as PoC:</p><figure class="w-richtext-align-center w-richtext-figure-type-image"><div><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/6af30e5a1ee82ec9924ecf26_poc.png" loading="lazy" alt=""/></div><figcaption><em>Achieving full RCE as root on Danfoss SM-800A <br/>(demo shows older fw version but applies to later versions as well)</em></figcaption></figure><p>‍</p><h3>Danfoss Security Levels &amp; Strict Mode</h3><p>The exploit demonstrated above was targeted at version 3.3.0, but the bugs are present in the latest version of the firmware as well (5.3.2 at the time of writing). </p><p>In later firmware versions, however, the concepts of <em>session control</em> and <em>security levels</em> were introduced by Danfoss [<a href="https://www.danfoss.com/en/service-and-support/downloads/dcs/adap-kool-software/ak-sm-800a/#tab-security" target="_blank">1</a>,<a href="https://assets.danfoss.com/documents/latest/590332/BC337629891709en-001101.pdf" target="_blank">2</a>]. According to Danfoss, session control is an <em>authentication rules engine</em> for the various remote interfaces (StoreView Browser, StoreView Web, Alsense, and 3rd party XML). This session control mechanism replaces the individual handler-level authentication enforcement mentioned above.</p><p>Session control has three security levels: backward compatible, permissive, and strict. Starting at 4.0 security level <em>strict</em> was set as the default which:</p><ul role="list"><li>Enforces HTTPS</li><li>3rd party XML requests cannot contain usernames and passwords and session tokens must be provided in the AKSM-auth header</li></ul><p>This AKSM-auth header mechanism historically held a base64 encoded username and password as the authentication key but now needs to include a session token derived from initial authentication [<a href="https://assets.danfoss.com/documents/latest/353954/AQ456722659855en-000201.pdf" target="_blank">3</a>]. At the <em>strict </em>security level, virtually all the web-accessible attack surface is fenced off from unauthenticated users (including the bug that was used in the exploit above) which is why enabling this security control was included in CERT-FR&#x27;s <a href="https://cert.cyber.gouv.fr/alerte/CERTFR-2026-ALE-012/" target="_blank">official mitigations</a>.</p><p>Unfortunately, it <strong>t</strong><strong>urns out the session control mechanism also has at least one trivial pre-authentication memory corruption vulnerability.</strong></p><p>The way this is implemented is through a separate binary: <em>sm_fcgi_app</em>. It acts as a <em>Web Application Firewall</em> (WAF) in the sense that it passes through all commands to NGINX if it believes that the user is authenticated. If not, then the only command allowed to be passed through is the <em>getauth </em>command, which is used to authenticate.</p><p>At first glance i spotted a potential for <a href="https://about.gitlab.com/blog/how-to-exploit-parser-differentials/" target="_blank">parser differential attacks</a> on <em>sm_fcgi_app </em>which might open the entire attack surface to unauthenticated users, but decided to investigate a quicker route to success. It turns out there&#x27;s another simple <em>strcpy </em>based pre-authentication memory corruption:</p><p>‍</p><pre contenteditable="false" class="w-code-block" style="display:block;overflow-x:auto;background:#2b2b2b;color:#f8f8f2;padding:0.5em"><code class="language-bash" style="white-space:pre-wrap"><span><span>$ curl -k -v -d &lt;redacted&gt; -A </span><span style="color:#abe338">&quot;</span><span class="hljs-subst" style="color:#abe338">$(echo &#x27;print(</span><span class="hljs-subst" style="color:#abe338">&quot;A&quot;</span><span class="hljs-subst" style="color:#abe338">*1536)</span><span style="color:#abe338">&#x27;|python)&quot;</span><span> https://127.0.0.1:3443/&lt;redacted&gt;.cgi </span></span><span>... </span><span>&gt; POST /&lt;redacted&gt;.cgi HTTP/1.1 </span><span>&gt; Host: 127.0.0.1:3443 </span><span>&gt; User-Agent: AAAAAAAAAAAAAAAA...AAAAAAAAAAAAAAAA </span><span>&gt; Accept: */* </span><span>&gt; Content-Length: 41 </span><span>&gt; Content-Type: application/x-www-form-urlencoded </span><span>&gt; </span></code></pre><p>‍</p><p>Running this against the latest AK-SM800A firmware with <em>strict </em>session control enabled produces a SEGFAULT which, with some additional effort, can be turned into yet another pre-authentication RCE. It goes without saying that <em>sm_fcgi_app </em>does not have stack canaries and PIE enabled either. I think we&#x27;re done here, we&#x27;ve seen enough.</p><figure class="w-richtext-align-center w-richtext-figure-type-image"><div><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/6af30f993fbe198375fbc8dc_segfault3.png" loading="lazy" alt=""/></div></figure><p>‍</p><h3>Persistence and Bricking Risks</h3><p>The last thing we want to figure out is exactly how bad this can get.</p><p>It&#x27;s one thing to initiate long defrost cycles and spoil tens of millions of food <em>once</em>, but the typical response of defenders is to factory reset affected controllers, rotate credentials, apply patches, set <em>strict </em>session control mode, and possibly wall off the controllers from internet exposure. But any controllers that are hit continue to do their job in production.</p><p>Now, imagine an attacker who manages to persist on such controllers. They don&#x27;t just trigger the initial payload but they leave a little implant that survives a factory reset and firmware update. With OS level access, this isn&#x27;t too hard on typical Unix-like devices as shown in the <a href="https://cloud.google.com/blog/topics/threat-intelligence/barracuda-esg-exploited-globally" target="_blank">SALTWATER / SEASPY</a> malware for Barracuda devices, <a href="https://www.cisa.gov/news-events/analysis-reports/ar26-113a" target="_blank">FIRESTARTER</a> malware for Cisco devices, and <a href="https://arstechnica.com/information-technology/2023/03/malware-infecting-widely-used-security-appliance-survives-firmware-updates/" target="_blank">Sonicwall malware</a> all which survive firmware updates.</p><p>In such a scenario, an attacker could either retain remote access or leave a time-triggered payload for a 2nd (or 3rd...) strike - increasing damage by spoiling new batches of food. Alternatively, attackers could simply wipe flash memory and/or push a malformed firmware update to brick the controllers and render them permanently inoperable - requiring costly and time-consuming replacement similar to the TTPs deployed during the <a href="https://www.midnightblue.nl/blog/have-you-tried-turning-it-off-and-on-again-part-1" target="_blank">December 2025 attack on the Polish electric grid</a>.</p><p>Both approaches seem feasible against the AK-SM800A controllers since they do not make use of the i.MX6&#x27;s secure boot features as evidenced by checking some of the responsible One-Time Programmable (OTP) fuse registers.</p><p>‍</p><h2>Potential impact</h2><p>1. <strong>Full device take-over</strong>: Through remote code execution, an unauthenticated attacker can remotely run arbitrary code at the operating system level of the AK-SM800A controller. This would allow the attacker to change parameters or initiate unwanted actions (such as defrosting operations) while hiding their activities from any system logs. In addition, the lack of secure boot functionality would allow an attacker with RCE to persistently implant controllers to maintain access or have it trigger a secondary payload at a later point in time. Without deep introspection and forensics capabilities, determining whether a device is implanted at the firmware level (<strong>even after a factory reset</strong>) is infeasible.</p><p>‍</p><p>2. <strong>Equipment damage (bricking)</strong>: Due to the lack of secure boot, an attacker with RCE could push malicious firmware that simply renders the device inoperable and irrecoverable without specialized hardware intervention (e.g. by wiping flash memory and/or causing an infinite boot loop). Such a &#x27;<a href="https://en.wikipedia.org/wiki/Brick_(electronics)" target="_blank">bricking</a>&#x27; or wiper approach would require full device replacement. The dangers of such a scenario to OT equipment in particular and adversary deployment of such TTPs have been highlighted in previous blogposts by Midnight Blue [<a href="https://www.midnightblue.nl/blog/have-you-tried-turning-it-off-and-on-again-part-1" target="_blank">1</a>,<a href="https://www.midnightblue.nl/blog/have-you-tried-turning-it-off-and-on-again-on-bricking-ot-devices-part-2" target="_blank">2</a>]. <strong>This could potentially lead to freezers being unavailable for days or longer while controllers get replaced</strong>.</p><p>‍</p><h2>Mitigations</h2><p>In light of all of the above, we consider piecemeal patching or enabling of <em>strict </em>session control to be a misallocation of scarce security and personnel resources since they have minimal security ROI against such a fundamentally flawed codebase missing basic exploit mitigations and yielding multiple pre-auth RCEs with an hour&#x27;s casual glance.</p><p>Instead, we strongly recommend asset owners and system integrators to take the following course of action for all Danfoss, Copeland, and Dixell controllers and preferably for similar controllers by other vendors as well:</p><ol role="list"><li>Inventarise which controllers are internet exposed, not just on asset owner public IP ranges but also through system integrator 4G modems<br/>‍</li><li>Ensure controller management interfaces are only accessible through either a VPN, a private APN, or highly restrictive firewall-enforced IP whitelist (broad IP geofencing or blacklisting is <em>not</em> sufficient). As per <a href="https://cert.cyber.gouv.fr/alerte/CERTFR-2026-ALE-012/" target="_blank">CERT-FR recommendations</a>, IP whitelisting is an intermediate mitigation and not long-term sustainable due to the risk of configuration drift and change management challenges.</li></ol><p>‍</p></div></div></div></div></section><section class="smoke-section"><div class="container"><div class="padded-content"><div class="spread"><h2 data-w-id="1d7775dd-f930-2742-04d7-cc0544d31895" class="paragraph dark poppins medium gray">Related knowledge items</h2><a data-w-id="1d7775dd-f930-2742-04d7-cc0544d31897" href="/knowledge" class="contact-method w-inline-block"><div class="arrow-container"><div class="arrow-wrapper to-left"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f1cac87c9617936cf65738_arrow.svg" loading="lazy" alt="" class="arrow-inner"/></div><div class="arrow-wrapper"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f1cac87c9617936cf65738_arrow.svg" loading="lazy" alt="" class="arrow-inner"/></div></div><p class="paragraph orange poppins medium">All items</p></a></div><div class="knowledge-container w-dyn-list"><div fs-cmsload-mode="pagination" fs-cmsfilter-element="list" fs-cmsload-element="list" role="list" class="knowledge-list w-dyn-items"><div id="w-node-_1d7775dd-f930-2742-04d7-cc0544d318a1-5d6b140f" data-w-id="1d7775dd-f930-2742-04d7-cc0544d318a1" role="listitem" class="knowledge-item w-dyn-item"><a href="/blog/tetra-authentication-flaws" class="knowledge-link w-inline-block"><div class="knowledge-image"><img src="https://cdn.prod.website-files.com/64b4f6a11f3e7b73f26b76eb/6ad7b30c95f9826278098147_Industrial%20navy%20padlock%20with%20chrome%20shackle.png" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/64b4f6a11f3e7b73f26b76eb/6ad7b30c95f9826278098147_Industrial%20navy%20padlock%20with%20chrome%20shackle-p-500.png 500w, https://cdn.prod.website-files.com/64b4f6a11f3e7b73f26b76eb/6ad7b30c95f9826278098147_Industrial%20navy%20padlock%20with%20chrome%20shackle-p-800.png 800w, https://cdn.prod.website-files.com/64b4f6a11f3e7b73f26b76eb/6ad7b30c95f9826278098147_Industrial%20navy%20padlock%20with%20chrome%20shackle-p-1080.png 1080w, https://cdn.prod.website-files.com/64b4f6a11f3e7b73f26b76eb/6ad7b30c95f9826278098147_Industrial%20navy%20padlock%20with%20chrome%20shackle.png 1254w" class="image-inner"/></div><div class="knowledge-meta"><div class="paragraph poppins dark-gray">Oct 2026</div><div fs-cmsfilter-field="type" class="paragraph blue semibold as-label">Blog</div></div><h2 class="h3 mbot-0">TETRA authentication flaws</h2><p class="paragraph dark mbot-0">Limitations of authentication in TETRA, and how it fails to provide integrity guarantees</p><div class="knowledge-cta"><div data-w-id="1d7775dd-f930-2742-04d7-cc0544d318ab" class="contact-method"><p class="paragraph orange poppins medium">Read more</p><div class="arrow-container"><div class="arrow-wrapper to-left"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f1cac87c9617936cf65738_arrow.svg" loading="lazy" alt="" class="arrow-inner"/></div><div class="arrow-wrapper"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f1cac87c9617936cf65738_arrow.svg" loading="lazy" alt="" class="arrow-inner"/></div></div></div><div class="timing"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f1df6957b25ac0aac2036f_clock.svg" loading="lazy" alt="" class="timing-icon"/><div class="paragraph dark poppins mbot-0">10 minutes</div></div></div></a></div><div id="w-node-_1d7775dd-f930-2742-04d7-cc0544d318a1-5d6b140f" data-w-id="1d7775dd-f930-2742-04d7-cc0544d318a1" role="listitem" class="knowledge-item w-dyn-item"><a href="/blog/analyzing-the-taiwan-high-speed-rail-thsr-tetra-cyber-incident-part-1" class="knowledge-link w-inline-block"><div class="knowledge-image"><img src="https://cdn.prod.website-files.com/64b4f6a11f3e7b73f26b76eb/6a173209a90fb01682e74675_56_used.jpg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/64b4f6a11f3e7b73f26b76eb/6a173209a90fb01682e74675_56_used-p-500.jpg 500w, https://cdn.prod.website-files.com/64b4f6a11f3e7b73f26b76eb/6a173209a90fb01682e74675_56_used-p-800.jpg 800w, https://cdn.prod.website-files.com/64b4f6a11f3e7b73f26b76eb/6a173209a90fb01682e74675_56_used.jpg 1000w" class="image-inner"/></div><div class="knowledge-meta"><div class="paragraph poppins dark-gray">May 2026</div><div fs-cmsfilter-field="type" class="paragraph blue semibold as-label">Blog</div></div><h2 class="h3 mbot-0">Analyzing the Taiwan High-Speed Rail TETRA cyber incident - Part 1</h2><p class="paragraph dark mbot-0">Deep dive analysis of the TETRA cyber incident which disrupted operations at Taiwan High Speed Rail (THSR) in April 2026.</p><div class="knowledge-cta"><div data-w-id="1d7775dd-f930-2742-04d7-cc0544d318ab" class="contact-method"><p class="paragraph orange poppins medium">Read more</p><div class="arrow-container"><div class="arrow-wrapper to-left"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f1cac87c9617936cf65738_arrow.svg" loading="lazy" alt="" class="arrow-inner"/></div><div class="arrow-wrapper"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f1cac87c9617936cf65738_arrow.svg" loading="lazy" alt="" class="arrow-inner"/></div></div></div><div class="timing"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f1df6957b25ac0aac2036f_clock.svg" loading="lazy" alt="" class="timing-icon"/><div class="paragraph dark poppins mbot-0">30 minutes</div></div></div></a></div></div></div></div></div></section></div><div data-w-id="dda78c49-0681-ce9c-3595-81a854e2c851" class="footer-cover"></div><section id="work-with-us" class="footer"><div class="footer-contain"><div class="container vcenter"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a2a6f5623f82375edc5ef0_arrow%20down.svg" loading="lazy" data-w-id="0731d965-42ad-bc0b-556f-6fc76b4ca3b9" alt="arrow down" class="arrow-down mtop-0 mbot-2"/><div class="footer-cta-wrap"><h2 data-w-id="0731d965-42ad-bc0b-556f-6fc76b4ca3bb" class="h1 smaller center">Interested in working together?</h2><a href="#" class="button outline absolute w-button">Go to top</a></div><div data-w-id="0731d965-42ad-bc0b-556f-6fc76b4ca3bf" class="methods"><a href="mailto:sales[at]midnightblue[dot]nl" class="method w-inline-block"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a43a862c51f907b3cf929f_mail%20icon.svg" loading="lazy" alt="" class="contact-icon"/><div class="paragraph">sales[ ]midnightblue[ ]nl</div></a><a href="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64b8288f60eb4ca6ae6cd45f_sales%40midnightblue.nl-(0x9035856DF1D41F73)-public.asc.txt" class="method w-inline-block"><img src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/64a43b00d1825b3fa635cf18_key%20icon.svg" loading="lazy" alt="" class="contact-icon"/><div class="paragraph">PGP (0x9035856DF1D41F73)</div></a></div></div><div class="container"><div class="footer-meta"><div class="_25 automobile"><div class="paragraph gray">© 2025 Midnight Blue</div></div><div class="_25 automobile"><div class="paragraph gray">All Rights Reserved</div></div><div class="half right automobile"><a href="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/65f7fadfade737a64b2507b4_privacy_policy.pdf" target="_blank" class="paragraph gray">We Respect Your Privacy</a></div></div></div></div></section><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=64a2900ed5e9bb672af9b2ed" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/js/webflow.schunk.f2efb3c5440a81cf.js" type="text/javascript" integrity="sha384-VK02VJvMib7ytrF5M2joPWNtDQs366FZgEQ5B+Iwnjx0WBnwQXfootyziSYxdrmS" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/js/webflow.schunk.841c044f911c7bee.js" type="text/javascript" integrity="sha384-OCGOb2NLhLZbwyJmPyygnUsuKp53lk+To8MEMftnYNXta83fj522kPUMoioSwHHe" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/64a2900ed5e9bb672af9b2ed/js/webflow.33b83a6f.ffcc0fe01d45c088.js" type="text/javascript" integrity="sha384-hFOm9t7WRCdt+56GN/cKkiTTAuJSVp7BGCjnPe5NZ/hONtR8JFkTZGRT5x4mEKER" crossorigin="anonymous"></script><div class="cursor-wrap js-cursor-wrap"> <div class="cursor js-cursor"> <svg height="60" width="60" class="circle" fill="#EC9D30"> <circle cx="30" cy="30" r="7" /> </svg> </div> </div> <script> // Run the function when the page loads window.addEventListener('DOMContentLoaded', () => { // Add a click listener to elements with class .search-trigger document.querySelectorAll('.search-trigger').forEach(trigger => { trigger.addEventListener('click', () => { const input = document.querySelector('.search-input'); if (input) { input.focus(); } }); }); }); </script> <script> function addHoverEffect(classNames, group) { const elements = document.querySelectorAll(classNames.join(', ')); elements.forEach(element => { element.addEventListener('mouseover', () => { elements.forEach(sibling => { if (sibling !== element) { sibling.style.opacity = '0.3'; sibling.style.transition = 'opacity 0.3s ease'; } }); element.style.opacity = '1'; }); element.addEventListener('mouseout', () => { elements.forEach(sibling => { sibling.style.opacity = '1'; }); }); }); } // Separate groups addHoverEffect(['.nav-link'], 'nav-link'); </script> <!-- Text Animation --> <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" integrity="sha512-16esztaSRplJROstbIIdwX3N97V1+pZvV33ABoG1H2OyTttBxEGkTsoIVsiP1iaTtM8b3+hu2kB6pQ4Clr5yug==" crossorigin="anonymous" referrerpolicy="no-referrer"></script> <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" integrity="sha512-Ic9xkERjyZ1xgJ5svx3y0u3xrvfT/uPkV99LBwe68xjy/mGtO+4eURHZBW2xW4SZbFrF1Tf090XqB+EVgXnVjw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script> <script src="https://unpkg.com/split-type"></script> <script> gsap.registerPlugin(ScrollTrigger); const splitTypes = document.querySelectorAll('.reveal-type'); splitTypes.forEach((char,i) => { const text = new SplitType(char, {types: ['chars','words']}); gsap.from(text.chars, { scrollTrigger: { trigger: char, start: 'top 80%', end: 'top 20%', scrub: true, markers: false }, opacity: 0.1, stagger: 0.1, }) }); </script> <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script> <script> /*- MOUSE STICKY -*/ function lerp(a, b, n) { return (1 - n) * a + n * b } // Initialize Cursor class Cursor { constructor() { this.bind() this.cursor = document.querySelector('.js-cursor') this.mouseCurrent = { x: 0, y: 0 } this.mouseLast = { x: this.mouseCurrent.x, y: this.mouseCurrent.y } this.rAF = undefined } bind() { ['getMousePosition', 'run'].forEach((fn) => this[fn] = this[fn].bind(this)) } getMousePosition(e) { this.mouseCurrent = { x: e.clientX, y: e.clientY } } run() { this.mouseLast.x = lerp(this.mouseLast.x, this.mouseCurrent.x, 0.2) this.mouseLast.y = lerp(this.mouseLast.y, this.mouseCurrent.y, 0.2) this.mouseLast.x = Math.floor(this.mouseLast.x * 100) / 100 this.mouseLast.y = Math.floor(this.mouseLast.y * 100) / 100 this.cursor.style.transform = `translate3d(${this.mouseLast.x}px, ${this.mouseLast.y}px, 0)` this.rAF = requestAnimationFrame(this.run) } requestAnimationFrame() { this.rAF = requestAnimationFrame(this.run) } addEvents() { window.addEventListener('mousemove', this.getMousePosition, false) } on() { this.addEvents() this.requestAnimationFrame() } init() { this.on() } } const cursor = new Cursor() cursor.init(); //increase cursor scale when hovering buttons $(".button, .menu-link, .logo-link, .card-wrap, .method, .text-link, .input-field, .checkbox-field, .contact-method, .type, .filter_select, .knowledge-item, .pagination_page-button, .pagination-button, .hamburger, .anchor, .category-link, .link-overlay").mouseenter(function(){ $(".circle").addClass("grow"); }); $(".button, .menu-link, .logo-link, .card-wrap, .method, .text-link, .input-field, .checkbox-field, .contact-method, .type, .filter_select, .knowledge-item, .pagination_page-button, .pagination-button, .hamburger, .anchor, .category-link, .link-overlay").mouseleave(function(){ $(".circle").removeClass("grow"); }); </script> <script> // Get the cursor element const cursorElement = document.querySelector('.cursor'); // Function to hide the cursor element function hideCursor() { cursorElement.style.display = 'none'; } // Event listener for cursor leaving the viewport window.addEventListener('mouseleave', () => { hideCursor(); }); </script> <script src="https://cdn.prod.website-files.com/6330c0ebacf06abbc83b6eb3/64103732523ba652052e0223_lenis-bundled.txt"></script> <script> class Scroll extends Lenis { constructor() { super({ duration: .5, easing: (t) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t)), // https://easings.net direction: "vertical", smooth: true, smoothTouch: false, touchMultiplier: .5 }); this.time = 0; this.isActive = true; this.init(); } init() { this.config(); this.render(); this.handleEditorView(); } config() { // allow scrolling on overflow elements const overscroll = [ ...document.querySelectorAll('[data-scroll="overscroll"]') ]; if (overscroll.length > 0) { overscroll.forEach((item) => item.setAttribute("onwheel", "event.stopPropagation()") ); } // stop and start scroll btns const stop = [...document.querySelectorAll('[data-scroll="stop"]')]; if (stop.length > 0) { stop.forEach((item) => { item.onclick = () => { this.stop(); this.isActive = false; }; }); } const start = [...document.querySelectorAll('[data-scroll="start"]')]; if (start.length > 0) { start.forEach((item) => { item.onclick = () => { this.start(); this.isActive = true; }; }); } // toggle page scrolling const toggle = [...document.querySelectorAll('[data-scroll="toggle"]')]; if (toggle.length > 0) { toggle.forEach((item) => { item.onclick = () => { if (this.isActive) { this.stop(); this.isActive = false; } else { this.start(); this.isActive = true; } }; }); } // anchor links const anchor = [...document.querySelectorAll("[data-scrolllink]")]; if (anchor.length > 0) { anchor.forEach((item) => { const id = parseFloat(item.dataset.scrolllink); const target = document.querySelector(`[data-scrolltarget="${id}"]`); if (target) { //console.log(id, target); item.onclick = () => this.scrollTo(target); } }); } } render() { this.raf((this.time += 10)); window.requestAnimationFrame(this.render.bind(this)); } /* ---- */ handleEditorView() { const html = document.documentElement; const config = { attributes: true, childList: false, subtree: false }; const callback = (mutationList, observer) => { for (const mutation of mutationList) { if (mutation.type === "attributes") { const btn = document.querySelector(".w-editor-bem-EditSiteButton"); const bar = document.querySelector(".w-editor-bem-EditorMainMenu"); const addTrig = (target) => target.addEventListener("click", () => this.destroy()); if (btn) addTrig(btn); if (bar) addTrig(bar); } } }; const observer = new MutationObserver(callback); observer.observe(html, config); } } window.SmoothScroll = new Scroll(); </script></body></html>
