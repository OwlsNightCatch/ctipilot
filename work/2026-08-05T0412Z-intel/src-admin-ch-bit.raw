ent":540,"link":5001,"linkTarget":4310,"type":300,"children":5002,"documentId":5015},"ERy0dQyn9UrkT6pl1Xtd_","Kontakt","/de/kontakt",[5003,5009],{"id":5004,"handle":214,"title":5005,"current":540,"link":5006,"linkTarget":4310,"type":300,"children":5007,"documentId":5008},"NcOjkz3mFRH9UWJ4pIXum","Allgemeine Anfragen","/de/kontakt-anfragen",[],"347",{"id":5010,"handle":214,"title":5011,"current":540,"link":5012,"linkTarget":4310,"type":300,"children":5013,"documentId":5014},"xcb-ugFkGxi9v1TxSNOJL","Medienstellen","/de/bundesverwaltung-medienstellen",[],"161","171",[],[],[],[5020],{"name":5021,"language":7,"documentId":5022,"documentType":271,"contentType":5023,"metadata":5024},"footer-data-record",219,"footer-data",{"about":5025,"informed":5028,"furtherinformation":5043,"jsonLDEntities":5045,"translationPages":5046,"contactDataInformation":5047},{"aboutHeadline":5026,"description":5027,"copyright":214},"Über uns","Der Bundesrat ist die Regierung der Schweiz. Die Exekutivgewalt nimmt er mit der von ihm geführten Bundesverwaltung wahr.\n\u003C/br>\u003C/br>\n© Der Bundesrat",{"socialLinks":5029,"socialHeadline":5042,"newslettertext":4701,"newsletterlink":4702,"newsletternewtab":22,"target":4703},[5030,5034,5038],{"text":5031,"link":5032,"icon":5033,"target":4703},"@BR_Sprecher","https://x.com/BR_Sprecher","Twitter",{"text":5035,"link":5036,"icon":5037,"target":4703},"gov.ch","https://www.instagram.com/gov.ch/","Instagram",{"text":5039,"link":5040,"icon":5041,"target":4703},"@gov-ch","https://www.youtube.com/derschweizerischebundesratleconseilfederalsuisseilconsigliofederalesvizzero","Youtube","Social Media",{"furtherHeadline":5044},"Weitere Informationen",[],[],{},{"id":5049,"handle":5050,"title":5050,"current":540,"linkTarget":4310,"type":214,"children":5051,"documentId":214},252,"footer-navigation-de",[5052,5058,5064],{"id":5053,"handle":214,"title":5054,"current":540,"link":5055,"linkTarget":4310,"type":300,"children":5056,"documentId":5057},"XAFN-_NPpj1ELPRXGua_o","Rechtliches","/de/rechtliches",[],"253",{"id":5059,"handle":214,"title":5060,"current":540,"link":5061,"linkTarget":4310,"type":300,"children":5062,"documentId":5063},"PghtzpJC0lgTcKBqLXBGm","Impressum","/de/impressum-de",[],"259",{"id":5065,"handle":214,"title":5066,"current":540,"link":5067,"linkTarget":4310,"type":300,"children":5068,"documentId":5069},"z42vB4Q13FABe8LPs81SW","Netiquette","/de/netiquette",[],"1042",{"id":5071,"handle":5072,"title":5072,"current":540,"linkTarget":4310,"type":214,"children":5073,"documentId":214},255,"footer-menu-de",[5074,5079,5084,5089,5093,5098],{"id":5075,"handle":214,"title":5076,"current":540,"link":5077,"linkTarget":4703,"type":4704,"children":5078,"documentId":214},"eM98wEhNHtQEpAmXAtjZA","Arbeiten beim Bund","https://www.stelle.admin.ch/stelle/de/home.html",[],{"id":5080,"handle":214,"title":5081,"current":540,"link":5082,"linkTarget":4703,"type":4704,"children":5083,"documentId":214},"oWdzQwg9mXtsFJh4z4Lhu","Das Schweizer Parlament","https://www.parlament.ch/de",[],{"id":5085,"handle":214,"title":5086,"current":540,"link":5087,"linkTarget":4703,"type":4704,"children":5088,"documentId":214},"1bY6KsM53T2RhrPZeq-AY","Schweizerische Gerichte","https://www.eidgenoessischegerichte.ch/",[],{"id":5090,"handle":214,"title":5091,"current":540,"link":4989,"linkTarget":4310,"type":300,"children":5092,"documentId":4991},"QgUyNGjYmKcrWKMP4_mrl","Informationen für Medienschaffende",[],{"id":5094,"handle":214,"title":5095,"current":540,"link":5096,"linkTarget":4703,"type":4704,"children":5097,"documentId":214},"1Ly6NlB0SQ3iQYg11Quvw","Bundesrecht","https://www.fedlex.admin.ch/de/home?news_period=last_day&news_pageNb=1&news_order=desc&news_itemsPerPage=10",[],{"id":5099,"handle":214,"title":5100,"current":540,"link":5101,"linkTarget":4310,"type":300,"children":5102,"documentId":5103},"1MnpzSeEFWQNi5l_QJPLe","VoteInfo","/de/voteinfo-app-abstimmungen-wahlen",[],"1443",{"projectId":1919,"document":5105,"topics":5177,"publishers":5179,"coPublishers":5181,"contactData":5182},{"about":5106,"informed":5107,"furtherinformation":5109,"metadata":5110,"contentType":5121,"content":5122},{},{"socialLinks":5108},[],{},{"title":5111,"translationPages":5112,"contactDataInformation":5117,"publishDate":5118,"significantPublicationDate":5118,"newsLocation":5119,"easyLanguagePage":-1,"signLanguagePage":-1,"announcementDate":5120},"Cyberangriff auf SharePoint-Server",[5113,5115],{"lang":15,"slug":5114,"code":15},"/it/newnsb/1CjmpBBHQaMV82PjKEpcL",{"lang":12,"slug":5116,"code":12},"/fr/newnsb/1CjmpBBHQaMV82PjKEpcL",{},"2026-08-04T07:53:32.910Z","Bern","2026-08-04T00:00:00.000Z","nsb-complex-news-page",[5123,5140],{"identifier":5124,"id":5125,"properties":5126,"nestedContent":5139},"lead-contentpage","doc-1jv3t4klt0",{"nestedContent":5127,"type":5135,"dateInfo":5136,"metaInfoType":5137},[5128,5131],{"identifier":4297,"id":5129,"properties":5130},"doc-1jv3t4klu0",{"label":5111,"heading":4294},{"identifier":4301,"id":5132,"properties":5133},"doc-1jv3t4klu1",{"text":5134},"Bern, 04.08.2026 — Aufgrund eines erkannten Cyberangriffs auf die durch das Bundesamt für Informatik und Telekommunikation (BIT) betriebenen SharePoint-Server wurde der Zugriff für bundesexterne Personen via Internet gesperrt. Im Rahmen der Analyse des Vorfalls wurde festgestellt, dass rund 200 Konten kompromittiert wurden. Es gibt bislang keine Anzeichen dafür, dass Daten abgeflossen sind.","detail",{"publicationDate":5118,"significantPublicationDate":5118},{"name":5138},"newsCategories.medienmitteilung",[5128,5131],{"identifier":4333,"properties":5141},{"sectionStyles":5142,"nestedContent":5143},{},[5144],{"identifier":4339,"properties":5145},{"variation":5146,"anchorNavItems":5147,"nestedContent":5148},"center--xs",[],[5149,5153,5157,5161,5165,5169,5173],{"identifier":4301,"id":5150,"properties":5151},"doc-1jv3t8bo70",{"text":5152},"Mitte Juli hat Microsoft mehrere Schwachstellen in SharePoint bekannt gegeben. Bei SharePoint handelt es sich um eine weit verbreitete Webanwendung von Microsoft, welche unter anderem zur Kollaboration und als Dateiablage verwendet wird. Auch das BIT setzt das Produkt ein und betreibt dazu mehrere SharePoint-Server in den eigenen Datenzentren des Bundes. Nach der Veröffentlichung der entsprechenden Sicherheits-Updates hat das BIT die Arbeiten zum Einspielen in die eigenen Systeme umgehend aufgenommen.",{"identifier":4301,"id":5154,"properties":5155},"doc-1jv5sjddi0",{"text":5156},"Am Dienstag, 28. Juli, haben Sicherheitsspezialistinnen und -spezialisten Auffälligkeiten auf den SharePoint-Servern des BIT bemerkt. Umgehend nach Bestätigung des Verdachts hat das BIT den Zugriff auf SharePoint über das Internet blockiert und die Schwachstellen geschlossen. Der Cyberangriff wurde durch bisher unbekannte Akteure ausgeführt, welche mutmasslich durch die Ausnutzung dieser Schwachstellen in der SharePoint-Software ermöglicht wurde.",{"identifier":4301,"id":5158,"properties":5159},"doc-1jv5so05d0",{"text":5160},"Im Rahmen der Analysearbeiten wurde am Freitag, 31. Juli, durch die Sicherheitsspezialistinnen und -spezialisten festgestellt, dass die Zugangsdaten von mehreren Konten kompromittiert wurden. Darunter befanden sich Benutzer- wie auch technische Konten. Das BIT hat die entsprechenden Passwörter umgehend zurückgesetzt. Gemäss aktuellem Stand sind rund 200 Konten betroffen.",{"identifier":4448,"id":5162,"properties":5163},"doc-1jv3t8vpp0",{"label":5164,"heading":4446},"Keine Anzeichen für Datenabfluss",{"identifier":4301,"id":5166,"properties":5167},"doc-1jv3t9dpb0",{"text":5168},"Bei den Analysen wird das BIT vom Bundesamt für Cybersicherheit (BACS) und Microsoft unterstützt. Die bisherigen Analysen haben ergeben, dass es keine Anzeichen dafür gibt, dass neben der Kompromittierung der Zugangsdaten von 200 Konten weitere Daten abgeflossen sind. Die Analysearbeiten sind am Laufen. Auf der SharePoint-Plattform dürfen keine vertraulichen Informationen oder besonders schützenswerte Personendaten gespeichert werden.",{"identifier":4301,"id":5170,"properties":5171},"doc-1jv5pp8p60",{"text":5172},"Aktuell setzt das BIT die betroffenen SharePoint-Server präventiv neu auf. Der Zugriff auf SharePoint für bundesexterne Benutzerinnen und Benutzer über das Internet bleibt bis zum Abschluss der Arbeiten gesperrt. Personen aus der Bundesverwaltung können weiterhin auf ihre Dokumente zugreifen und sie über alternative Wege mit den betroffenen Personen austauschen.",{"identifier":4301,"id":5174,"properties":5175},"doc-1jv5pp8p80",{"text":5176},"Im Rahmen der Meldepflicht gemäss Informationssicherheitsgesetz (ISG) hat das BIT innert der geforderten Frist das Bundesamt für Cybersicherheit (BACS) sowie das Staatssekretariat für Sicherheitspolitik (SEPOS) über den Cybersicherheitsvorfall informiert. Um Betreiberinnen kritischer Infrastrukturen in der Schweiz zu schützen, hat das BIT proaktiv alle relevanten technischen Indikatoren zum Cyberangriff über die Plattform des BACS mit den Betreiberinnen kritischer Infrastrukturen geteilt.",[5178],"381",[5180],"47",[],[5183],"gd_821",["Reactive",5185],{},["Set",5187],"$3oRWNoOsuN",["ShallowReactive",5189],{"$fHKlZIzz-n59oKhO-_u3WU1e5ZoS-GPX_S-nwT3vQCsM":-1,"$fwufl64AudrT5sk9lvps602O4DXrlcF37gGcqLnmIWRY":-1,"index/data-records/office/de-all.json":-1,"index/data-records/department/de-all.json":-1,"index/data-records/government/de-all.json":-1,"index/data-records/site-identity/de-all.json":-1,"index/homepages/de-all.json":-1,"index/cookiepopup/de-all.json":5190,"main-menus/main-de.json":-1,"meta-navigation-menus/meta-navigation-de.json":-1,"topbar-navigation-menus/topbar-navigation-de.json":-1,"document_group_nnsb_1CjmpBBHQaMV82PjKEpcL":-1,"topics_de_":-1,"organisations_de_":-1,"contacts_de__":-1,"footer-data-de":-1,"index/data-records/footer-data/de-all.json":-1,"footer-nav-menu-de":-1,"footer-navigation-menus/footer-navigation-de.json":-1,"footer-menu-de":-1,"footer-menus/footer-menu-de.json":-1},["NuxtError",5191],{"message":519