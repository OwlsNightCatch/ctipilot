rsion":441,"slug":442,"articleAuthors":443,"lead":32,"mainSuperTag":451,"superTags":453,"flags":454,"live":9,"recommendedBoxImage":455,"mobileImage43":456,"mobileImage11":457,"active":8,"rank":101,"mirroringSites":458,"recommender":459,"colorClass":32,"coverEmbed":32,"coverEmbedTitle":32,"allowCoverEmbedForClk":9,"parent":32,"speech":460,"originatingSite":17,"subType":461,"subtitle":32,"headerType":32,"minute":32,"coverImage":50,"coverImageText":32,"facebookImage":462,"resizedRecommendedBoxImage":455,"coverImageSet":50,"content":463,"paragraphCount":464,"articleContributors":465,"tags":466,"avCode":32,"ogDescription":459,"actions":495,"contextTitle":32,"contextLead":32,"livescoreId":32,"relatedArticles":497,"facebookTitle":439},200297,"Kibertámadás érte a Magyar Államkincstárat, a szakértőik szerint orosz szerverekről",1785694502,1785695910,"magyar-allamkincstar-nemzeti-kifizeto-ugynokseg-kibertamadas-orosz-szerver-titkositott-allomanyok",[444],{"id":445,"authorId":446,"name":447,"email":448,"slug":449,"avatarSrc":450,"position":51,"information":32,"title":50,"facebookUrl":32,"linkedinUrl":32,"organization":32},233885,162,"Bakró-Nagy Ferenc","bakronagyf@telex.hu","bakro-nagy-ferenc","https://assets.telex.hu/images/0_szerzok/nagy_avatar/_JO_4826_avatar.jpeg",{"id":452,"name":233,"slug":160,"siteSlug":17,"active":8},45,[],[],"https://assets.telex.hu/images/20260802/1785694840-temp-9sttvcgrdgap0inpokp_cimlap-normal.jpg","https://assets.telex.hu/images/20260802/1785694896-temp-1g6dbpn4dqqbbfcjcbe_cimlap-normal-4per3.jpg","https://assets.telex.hu/images/20260802/1785694941-temp-9vrdfqjvvcdg8okogap_cimlap-normal-1per1.jpg",[17],"Az incidens következtében egyes dolgozók számítógépén lévő állományok titkosítottá váltak.","https://audio-assets.telex.hu/20260802/1785695903-1univdq01epj4cfhimj.mp3","N","https://assets.telex.hu/images/20260802/1785694576-temp-02qlppcnmr7jbmnheff_facebook.jpg","\u003Cp>A Magyar Államkincstár Mezőgazdasági és Vidékfejlesztési szakterületének, azaz a Nemzeti Kifizető Ügynökségnek az informatikai hálózatát kibertámadás érte. A Kincstár informatikai szakértői az észlelést követően haladéktalanul leválasztották a fertőzéssel érintett szervereket, és megtették a szükséges intézkedéseket a további károk elkerülése érdekében – közölte a Telex érdeklődésére a Magyar Államkincstár.\u003C/p>\u003Cp>A jelenlegi információk alapján az incidens során adatvesztés nem történt, az incidens nem érinti a Kincstár által kezelt ügyféladatokat. Az incidens következtében egyes belső felhasználók, munkatársak számítógépén lévő állományok titkosítottá váltak.\u003C/p>\u003Cblockquote>\u003Cp>A szakértők jelenlegi információi szerint a támadás orosz szerverekről történt.\u003C/p>\u003C/blockquote>\u003Cp>Az esemény teljes körű kivizsgálása a Nemzeti Kiberbiztonsági Intézet szakértőinek közreműködésével zajlik, összehangoltan dolgoznak a támadás elhárításán és a biztonságos működés mielőbbi helyreállításán. Az incidens bejelentése a Nemzeti Adatvédelmi és Információszabadság Hatóság (NAIH) felé megtörtént.\u003C/p>\u003Cp class=\"ad\" data-index=\"1\">\u003Cplaceholder-view :english=\"false\" class=\"placeholder ad\" content-type=\"ad\" :index=\"1\"> \u003C/placeholder-view>\u003C/p>\u003Cp>A vizsgálat idején biztonsági okokból a Mezőgazdasági és Vidékfejlesztési szakterület egyes elektronikus szolgáltatásai korlátozottan lesznek elérhetőek. A Kincstár az esetleges szolgáltatáskiesésekért a felhasználók türelmét és megértését kéri.\u003C/p>",7,[],[467,471,475,479,483,487,491],{"id":468,"name":469,"slug":470},475,"kibertámadás","kibertamadas",{"id":472,"name":473,"slug":474},829,"Oroszország","oroszorszag",{"id":476,"name":477,"slug":478},2863,"Nemzeti Adatvédelmi és Információszabadság Hatóság","nemzeti-adatvedelmi-es-informacioszabadsag-hatosag",{"id":480,"name":481,"slug":482},8513,"hekkertámadás","hekkertamadas",{"id":484,"name":485,"slug":486},9716,"Magyar Államkincstár","magyar-allamkincstar",{"id":488,"name":489,"slug":490},58194,"Nemzeti Kiberbiztonsági Intézet","nemzeti-kiberbiztonsagi-intezet",{"id":492,"name":493,"slug":494},58195,"Nemzeti Kifizető Ügynökség","nemzeti-kifizeto-ugynokseg",{"recommended":496},"/api/recommended/mstag/all{?v}",[],{"quizzes":499,"answers":500},[],[],{"isSupportLinkBlocked":9},{"user":32,"subscriptions":32,"subscriptionsInited":9,"showProfileModal":9,"userChecked":9},{"visible":9,"minimalized":51,"episode":32,"playing":9,"autoPlay":8},{"recommenderBoxVersions":505,"random":32,"special":32,"breaking":32,"important":32,"newest":32,"favorite":32,"pr":32,"after":32,"g7":32,"karakter":32},[],{"imageItems":507,"subImageItems":508,"quizImageItems":509,"otherImageItems":510,"imageIndex":32,"isGallery":9,"lastImageThumb":32},[],[],[],[]]</script></body></html>