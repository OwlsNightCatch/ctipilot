:4182},320,"https://prod-vbsch-hcms-sdweb.imgix.net/2023/12/04/b6cc58c2-469f-48a8-801f-49bfd056028e.jpeg?rect=0%2C63%2C1200%2C675&w=320&auto=format",{"isAutomatic":19,"x":4184,"y":4165,"width":4185,"height":4185,"name":4186,"url":4187,"ratio":4188,"srcSet":4189},200,800,"1:1","https://prod-vbsch-hcms-sdweb.imgix.net/2023/12/04/b6cc58c2-469f-48a8-801f-49bfd056028e.jpeg?rect=200%2C0%2C800%2C800&w=1024&auto=format",1,[4190,4192,4193,4195],{"width":4173,"url":4191},"https://prod-vbsch-hcms-sdweb.imgix.net/2023/12/04/b6cc58c2-469f-48a8-801f-49bfd056028e.jpeg?rect=200%2C0%2C800%2C800&w=2048&auto=format",{"width":4176,"url":4187},{"width":4178,"url":4194},"https://prod-vbsch-hcms-sdweb.imgix.net/2023/12/04/b6cc58c2-469f-48a8-801f-49bfd056028e.jpeg?rect=200%2C0%2C800%2C800&w=620&auto=format",{"width":4181,"url":4196},"https://prod-vbsch-hcms-sdweb.imgix.net/2023/12/04/b6cc58c2-469f-48a8-801f-49bfd056028e.jpeg?rect=200%2C0%2C800%2C800&w=320&auto=format","zH9hnwib4Ijh","https://prod-vbsch-hcms-sdweb.imgix.net/2023/12/04/b6cc58c2-469f-48a8-801f-49bfd056028e.jpeg?w=1024&auto=format","Das VBS ist für die Sicherheitspolitik der Schweiz zuständig – mit der Armee, dem Staatssekretariat für Sicherheitspolitik, dem Bundesamt für Bevölkerungsschutz, dem Nachrichtendienst des Bundes, der armasuisse und dem Bundesamt für Cybersicherheit. Die Sportförderung mit dem Bundesamt für Sport oder die Geoinformation mit swisstopo sind weitere Pfeiler des Departementes.","Das VBS – Sicherheit für die Schweiz",[],[4203,4204,4205],{"lang":15,"slug":211},{"lang":12,"slug":211},{"lang":18,"slug":211},[],[4208],"110","3503","Das VBS hat die Aufgabe, die Schweizer Sicherheitspolitik auszuarbeiten. Der Auftrag des VBS umfasst auch die Sportförderung sowie die Geoinformation.","VBS, Armee, Nachrichtendienst, Cyber, Sicherheit, Bevölkerungsschutz, Sport, Geoinformation, Schweiz","all",{"description":4210,"image":211,"title":4200,"type":4214,"url":211},"website",{"card":4216,"description":4210,"image":211,"site":4217,"title":4200},"summary","@vbs_ddps",{},{},null,{"id":4222,"title":4223,"name":4224,"job-title":211,"address-line-1":211,"address-line-2":211,"street":4225,"contactType":4226,"city":4234,"country":4235,"openingHours":4236,"freetext":211,"iframe":4238,"internal-link":211,"external-link":211,"file-map":211,"postal-code":4241,"map-image":4242},"cf2586e0-46d4-4d8a-b694-b70c487672b0","Kontakt","Eidgenössisches Departement für Verteidigung, Bevölkerungsschutz und Sport VBS","Bundeshaus Ost",{"allContactType":4227},[4228,4231],{"contact-text":4229,"contact-type":4230},"+41 58 462 21 11","phone",{"contact-text":4232,"contact-type":4233},"postmaster-vbs@gs-vbs.admin.ch","email","Bern","CH",{"allOpeningHours":4237},[],{"url":4239,"ratio":4240,"title":4225,"width":211,"height":211},"https://map.geo.admin.ch/embed.html?E=2600521.00&N=1199502.63&zoom=10&crosshair=bowl","4/3","3003",{},[4244,4291,4370,4430,4523],{"properties":4245,"identifier":4247,"id":4248,"nestedContent":4249},{"type":4246},"main","lead-homepage","doc-1harbabd80",[4250,4258,4262,4279],{"properties":4251,"identifier":4256,"id":4257},{"heading":4252,"label":4253,"class":4254,"anchorNav":4255},"h1","Sicherheit für die Schweiz","hero__title","Sicherheit-für-die-Schweiz","title","doc-1harbabd81",{"properties":4259,"identifier":4260,"id":4261},{"text":4199},"p","doc-1i0nitj2t0",{"properties":4263,"identifier":4264,"id":4265,"nestedContent":4266},{},"call-to-action-container","doc-1harbabd83",[4267,4274],{"properties":4268,"identifier":4272,"id":4273},{"text":4269,"link":4270,"target":4271},"Departementschef","/de/c-vbs","_self","call-to-action-element","doc-1harbabd84",{"properties":4275,"identifier":4272,"id":4278},{"text":4276,"link":4277,"target":4271},"VBS-Clip","/de/kurzfilm","doc-1harbabd90",{"properties":4280,"identifier":4289,"id":4290},{"imagePath":4281,"legend":211,"textPosition":4220,"textProportion":4220,"imageAlt":211,"text":211,"pictureSources":4282},"https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/zH9hnwib4Ijh/95625619-2365-4636-b5ec-3160e370c42b?rect=91%2C0%2C1067%2C800&w=1024&auto=format",[4283,4286],{"src":4284,"media":4285},"https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/zH9hnwib4Ijh/95625619-2365-4636-b5ec-3160e370c42b?rect=91%2C0%2C1067%2C800&auto=format&w=4096 4096w, https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/zH9hnwib4Ijh/95625619-2365-4636-b5ec-3160e370c42b?rect=91%2C0%2C1067%2C800&auto=format&w=2048 2048w, https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/zH9hnwib4Ijh/95625619-2365-4636-b5ec-3160e370c42b?rect=91%2C0%2C1067%2C800&auto=format&w=1240 1240w, https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/zH9hnwib4Ijh/95625619-2365-4636-b5ec-3160e370c42b?rect=91%2C0%2C1067%2C800&auto=format&w=640 640w","(min-resolution: 2dppx)",{"src":4287,"media":4288},"https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/zH9hnwib4Ijh/95625619-2365-4636-b5ec-3160e370c42b?rect=91%2C0%2C1067%2C800&auto=format&w=2048 2048w, https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/zH9hnwib4Ijh/95625619-2365-4636-b5ec-3160e370c42b?rect=91%2C0%2C1067%2C800&auto=format&w=1024 1024w, https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/zH9hnwib4Ijh/95625619-2365-4636-b5ec-3160e370c42b?rect=91%2C0%2C1067%2C800&auto=format&w=620 620w, https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/zH9hnwib4Ijh/95625619-2365-4636-b5ec-3160e370c42b?rect=91%2C0%2C1067%2C800&auto=format&w=320 320w","(min-resolution: 1dppx)","image","doc-1harbabd92",{"properties":4292,"identifier":4296,"id":4297,"nestedContent":4298},{"sectionStyles":4293},{"section-color":4294,"section-variation":4295},"first-color","full","section","doc-1i1p7qjah0",[4299],{"properties":4300,"identifier":4302,"id":4303,"nestedContent":4304},{"variation":4295,"anchorNavItems":4301},[],"container-grid","doc-container-grid-1785908206902-132",[4305],{"properties":4306,"identifier":4312,"id":4313,"nestedContent":4314},{"idComponent":4307,"title":145,"variant":4308,"link":4309},"teaser-focus-doc-1jd5o2cu31","teaser-focus",{"label":4310,"url":4311,"target":4271},"Alle Mitteilungen","https://www.vbs.admin.ch/de/overview/news","teaser-container","doc-1jd5o2cu31",[4315,4327,4335,4343,4352],{"properties":4316,"identifier":4326,"id":4317},{"idComponent":4317,"title":4318,"description":4319,"slug":4320,"imageURL":4321,"imageAlt":4322,"footerAction":4323,"linkTargetLabelBlank":4324,"linkAlt":4325},"doc-1jusiukgm0","«Die Schweiz wird nicht allein von Schienen und Strassen zusammengehalten. Sondern von Menschen, die mehr tun als ihre Pflicht.»","Ansprache von Bundesrat Martin Pfister anlässlich der 1. August-Feier, Rorschach, 31. Juli 2026.","https://www.vbs.admin.ch/de/newnsb/Kwpak-64HgXv","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/xgDUgd4Ucjm3/bundesrat-martin-pfister-rohrschach-02.jpg?w=1024&auto=format","Bundesrat Martin Pfister anlässlich der 1. August-Feier, Rorschach, 31. Juli 2026","external","Link in neuem Tab öffnen","Mehr über «Die Schweiz wird nicht allein von Schienen und Strassen zusammengehalten. Sondern von Menschen, die mehr tun als ihre Pflicht.»","external-teaser",{"properties":4328,"identifier":4326,"id":4329},{"idComponent":4329,"title":4330,"description":4331,"slug":4332,"imageURL":4333,"imageAlt":211,"footerAction":4323,"linkTargetLabelBlank":4324,"linkAlt":4334},"doc-1jtkva4l90","Die Schweizer Armee verlängert den Löscheinsatz auf Korsika","Die drei Super-Puma-Helikopter der Schweizer Armee unterstützen die französischen Einsatzkräfte weiterhin bei der Bekämpfung der Waldbrände auf Korsika.","https://www.vbs.admin.ch/de/newnsb/mCju8Kxr7RGg","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/8PyzZuiJ52jW/vbs-ddps-super-puma-braende-frankreich-2026-02.jpg?w=1024&auto=format","Mehr über Die Schweizer Armee verlängert den Löscheinsatz auf Korsika",{"properties":4336,"identifier":4326,"id":4337},{"idComponent":4337,"title":4338,"description":4339,"slug":4340,"imageURL":4341,"imageAlt":211,"footerAction":4323,"linkTargetLabelBlank":4324,"linkAlt":4342},"doc-1ju4bvs3t0","Der volkswirtschaftliche Wert geologischer Daten des Bundes","Bauprojekte werden komplexer, der Platz an der Oberfläche knapper. Immer mehr Vorhaben verlagern sich deshalb in den Untergrund. Für fundierte Entscheidungen braucht es dort vor allem eines: verlässliche geologische Informationen.","https://www.swisstopo.admin.ch/de/volkswirtschaftlicher-wert-geologischer-daten","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/1qLktQRHwmxM/260722-Geodaten.jpg?w=1024&auto=format","Mehr über Der volkswirtschaftliche Wert geologischer Daten des Bundes",{"properties":4344,"identifier":4326,"id":4345},{"idComponent":4345,"title":4346,"description":4347,"slug":4348,"imageURL":4349,"imageAlt":4350,"footerAction":4323,"linkTargetLabelBlank":4324,"linkAlt":4351},"doc-1jrcmopkd0","Neuauflage des Lehrmittels «Wie sicher sind wir?» stärkt sicherheitspolitische Bildung","Das Staatssekretariat für Sicherheitspolitik und die Pädagogische Hochschule Luzern haben das hybride Lehrmittel «Wie sicher sind wir?» überarbeitet und in einer Neuauflage veröffentlicht.","https://www.vbs.admin.ch/de/newnsb/tRyY1EqhfLVTbj0WWrpLe","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/Zl1C6pUwFw2z/260716-lehrmittel-sepos-de.jpg?w=1024&auto=format","Lehrmittels «Wie sicher sind wir?», SEPOS","Mehr über Neuauflage des Lehrmittels «Wie sicher sind wir?» stärkt sicherheitspolitische Bildung",{"properties":4353,"identifier":4368,"id":4369},{"title":4354,"slug":4355,"description":4356,"imageURL":4357,"imageAlt":211,"teaserType":4358,"language":7,"date":4359,"metaInfo":4360,"isPublicationDateHidden":1809,"eventInfos":4220,"authors":4363,"contentIcons":4364,"contentSpecs":4365,"federalTopic":4366,"contentType":4367},"Lernendenlager VBS 2026: Gemeinsam unterwegs im Urserental","/de/lernendenlager-vbs-2026","Mehr als fünfzig Lernende nahmen am diesjährigen Lernendenlager des VBS teil und verbrachten eine vielseitige Woche im Kompetenzzentrum Gebirgsdienst der Armee in Andermatt.","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/vrZVnnsDsktA/Lernendenlager-2026-01.jpg?rect=0%2C0%2C1920%2C1080&w=1024&auto=format","default","14. Juli",{"type":4361,"date":4362},"Mitteilung","2026-07-14T07:00:00.000Z",[],[],{},[],"news-page","teaser-item","doc-1jtfn9cgg0",{"properties":4371,"identifier":4296,"id":4373,"nestedContent":4374},{"sectionStyles":4372},{"section-variation":4295},"doc-1iglfurto0",[4375],{"properties":4376,"identifier":4377,"id":4378,"nestedContent":4379},{},"container","doc-container-1785908206902-729",[4380],{"properties":4381,"identifier":4387,"id":4388,"nestedContent":4389},{"title":4382,"link":4383,"variant":4386},"Medienmitteilungen",{"label":4384,"url":4385,"target":4271},"Alle Medienmitteilungen","https://www.vbs.admin.ch/de/newnsb?publisherIDs=5&topicIDs=all&newsCategoryIDs=all","teaser-carousel","teaser-nsb-container","doc-1iglfvlsr0",[4390,4398,4405,4411,4417,4423],{"properties":4391,"identifier":4397},{"title":4392,"slug":4393,"description":4394,"teaserType":4358,"metaInfo":4395},"Cybervorfall bei der RUAG MRO: VBS schliesst Prüfung ab und empfiehlt weitere Massnahmen","/de/newnsb/5bBC1HPXGI21","Das Eidgenössische Departement für Verteidigung, Bevölkerungsschutz und Sport (VBS) hat den Cybervorfall bei einer US-Tochtergesellschaft der RUAG MRO sowie den Umgang des Unternehmens mit dem Vorfall überprüft. Die Untersuchung kommt zum Schluss, dass der Entscheid der RUAG MRO zur Zahlung eines Lösegelds im Rahmen ihrer unternehmerischen Verantwortung getroffen wurde und keine Anhaltspunkte für eine Rechtsverletzung bestehen. Gleichzeitig zeigt die Prüfung Verbesserungspotenzial bei der gesamtheitlichen Risikoabwägung und beim Informationsfluss gegenüber dem Bund als Eigner auf. Das VBS hat entsprechende Empfehlungen ausgesprochen und weitere Massnahmen eingeleitet, die rasch umgesetzt werden.",{"date":4396},"2026-08-04","teaser-item-nsb",{"properties":4399,"identifier":4397},{"title":4400,"slug":4401,"description":4402,"teaserType":4358,"metaInfo":4403},"Der Chef Kommando Operationen auf dem Balkan zu Besuch","/de/newnsb/gt5MPlXSQq3m","Korpskommandant Laurent Michaud, Chef Kommando Operationen, hat vom 30. Juli bis 2. August 2026 die mit der SWISSCOY in der Kosovo Force (KFOR) und der European Union Force (EUFOR) in Bosnien und Herzegowina im Einsatz stehenden Schweizer Armeeangehörigen besucht. Begleitet wurde er von Daniel Büchel, Generalsekretär des VBS.",{"date":4404},"2026-08-02",{"properties":4406,"identifier":4397},{"title":4330,"slug":4407,"description":4408,"teaserType":4358,"metaInfo":4409},"/de/newnsb/mCju8Kxr7RGg","Die drei Super-Puma-Helikopter der Schweizer Armee unterstützen die französischen Einsatzkräfte weiterhin bei der Bekämpfung der Waldbrände auf Korsika. Der auf sieben Tage geplante Einsatz wird aufgrund des weiterhin bestehenden Unterstützungsbedarfs um weitere vier Tage bis Freitag, 7. August 2026, verlängert.",{"date":4410},"2026-08-01",{"properties":4412,"identifier":4397},{"title":4318,"slug":4413,"description":4414,"teaserType":4358,"metaInfo":4415},"/de/newnsb/Kwpak-64HgXv","Ansprache von Bundesrat Martin Pfister, Chef des Eidgenössischen Departements für Verteidigung, Bevölkerungsschutz und Sport (VBS), anlässlich der 1. August-Feier, Rorschach, 31. Juli 2026.",{"date":4416},"2026-07-31",{"properties":4418,"identifier":4397},{"title":4419,"slug":4420,"description":4421,"teaserType":4358,"metaInfo":4422},"Die Schweizer Armee unterstützte den Kanton Bern bei der Wasserversorgung von Alpbetrieben","/de/newnsb/InyAqeWmo7ij","Die Armee unterstützte den Kanton Bern heute Freitag, 31. Juli 2026 bei der Wasserversorgung von zwei Alpbetrieben im Berner Oberland, die schwer von der anhaltenden Trockenheit betroffen sind. Die Unterstützungsleistung erfolgte gestützt auf die Verordnung über die Unterstützung ziviler oder ausserdienstlicher Tätigkeiten mit militärischen Mitteln (VUM).",{"date":4416},{"properties":4424,"identifier":4397},{"title":4425,"slug":4426,"description":4427,"teaserType":4358,"metaInfo":4428},"Die Schweiz unterstützt Frankreich mit drei Armee-Helikoptern bei der Brandbekämpfung","/de/newnsb/lvgciQmUqPzo","In Frankreich wüten Brände in mehreren Regionen. Die Schweiz reagiert auf ein Hilfsersuchen der französischen Behörden und entsendet drei Armee-Helikopter sowie bis zu 20 Spezialisten zur Brandbekämpfung nach Korsika.",{"date":4429},"2026-07-27",{"properties":4431,"identifier":4296,"id":4433,"nestedContent":4434},{"sectionStyles":4432},{"section-color":4294,"section-variation":4295},"doc-1iglgr2180",[4435],{"properties":4436,"identifier":4302,"id":4438,"nestedContent":4439},{"variation":4295,"anchorNavItems":4437},[],"doc-container-grid-1785908206902-338",[4440],{"properties":4441,"identifier":4312,"id":4445,"nestedContent":4446},{"idComponent":4442,"title":4443,"variant":4444,"link":4220},"teaser-grid-doc-1jd5o6d0g0","Schwerpunkte","teaser-grid","doc-1jd5o6d0g0",[4447,4455,4463,4479,4494,4508],{"properties":4448,"identifier":4326,"id":4449},{"idComponent":4449,"title":4450,"description":4451,"slug":4452,"imageURL":4453,"imageAlt":211,"footerAction":4323,"linkTargetLabelBlank":4324,"linkAlt":4454},"doc-1jk540g850","Armeebotschaft 2026","Der Bundesrat beantragt dem Parlament Verpflichtungskredite von 3,4 Milliarden Franken. Davon sind 2,9 Milliarden Franken für Rüstungsbeschaffungen und 562 Millionen Franken für Immobilienprojekte vorgesehen.","https://www.vtg.admin.ch/de/armeebotschaft-2026","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/aoutc2gAt5U5/260320-ab26-drohnenabwehr-hauptbild.jpg?w=1024&auto=format","Mehr über Armeebotschaft 2026",{"properties":4456,"identifier":4326,"id":4457},{"idComponent":4457,"title":4458,"description":4459,"slug":4460,"imageURL":4461,"imageAlt":211,"footerAction":4323,"linkTargetLabelBlank":4324,"linkAlt":4462},"doc-1jd5o6d0g1","Sicherheitspolitische Strategie","Die sicherheitspolitische Strategie 2026 bezieht alle Mittel von Bund und Kantonen mit ein. Die Stossrichtungen sind: Resilienz stärken, Schutz und  Abwehr verbessern, Verteidigungsfähigkeit erhöhen.","https://www.sepos.admin.ch/de/sicherheitspolitische-strategie","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/aM7JhB1e8631/251212-sipol-strategie.jpg?w=1024&auto=format","Mehr über Sicherheitspolitische Strategie",{"properties":4464,"identifier":4368,"id":4478},{"title":4465,"slug":4466,"description":4467,"imageURL":4468,"imageAlt":4469,"teaserType":4358,"language":7,"date":4470,"metaInfo":4471,"isPublicationDateHidden":19,"eventInfos":4220,"authors":4473,"contentIcons":4474,"contentSpecs":4475,"federalTopic":4476,"contentType":4477},"Finanzierung der Armee","/de/finanzierung-armee","Der Bundesrat sieht eine befristete Erhöhung der Mehrwertsteuer um 0,5 Prozentpunkte vor. Die zusätzlichen Einnahmen fliessen vollständig in Rüstungsausgaben der Armee.","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/jBa7gq0ZBKaP/vbs-ddps-dossier-finanzierung-armee.jpg?rect=0%2C0%2C1920%2C1080&w=1024&auto=format","Wärmebildgerät mittlerer Sichtweite beim Beobachtungseinsatz","8. Juli",{"type":211,"date":4472},"2026-07-08T07:00:00.000Z",[],[],{},[4208],"webdossier-page","doc-1jd5o6d0g3",{"properties":4480,"identifier":4368,"id":4493},{"title":4481,"slug":4482,"description":4483,"imageURL":4484,"imageAlt":211,"teaserType":4358,"language":7,"date":4485,"metaInfo":4486,"isPublicationDateHidden":19,"eventInfos":4220,"authors":4488,"contentIcons":4489,"contentSpecs":4490,"federalTopic":4491,"contentType":4492},"Top-Projekte VBS","/de/top-projekte","Das VBS führt bedeutende Projekte durch, um die Sicherheit der Schweiz zu stärken und die Entwicklung der Armee, des Bevölkerungsschutzes und des Sports voranzutreiben.","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/11LDo5QuDWrs/250212-projektbericht-top-projekte.jpg?rect=0%2C0%2C1920%2C1080&w=1024&auto=format","12. Feb.",{"type":211,"date":4487},"2026-02-12T16:00:00.000Z",[],[],{},[4208],"content-page","doc-1jd5o6d0g4",{"properties":4495,"identifier":4368,"id":4507},{"title":4496,"slug":4497,"description":4498,"imageURL":4499,"imageAlt":211,"teaserType":4358,"language":7,"date":4500,"metaInfo":4501,"isPublicationDateHidden":19,"eventInfos":4220,"authors":4503,"contentIcons":4504,"contentSpecs":4505,"federalTopic":4506,"contentType":4477},"Revision Nachrichtendienstgesetz","/de/nachrichtendienstgesetz","Das Nachrichtendienstgesetz regelt die Aufgaben und Befugnisse des NDB, insbesondere bei der Abwehr von Bedrohungen wie Terrorismus und Spionage.","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/B39jqU4GWt6e/Dossier-NDG-Revision.jpg?rect=0%2C0%2C1920%2C1080&w=1024&auto=format","12. Juni",{"type":211,"date":4502},"2026-06-12T10:20:00.000Z",[],[],{},[4208],"doc-1jd5o6d0g6",{"properties":4509,"identifier":4368,"id":4522},{"title":4510,"slug":4511,"description":4512,"imageURL":4513,"imageAlt":4514,"teaserType":4358,"language":7,"date":4515,"metaInfo":4516,"isPublicationDateHidden":19,"eventInfos":4220,"authors":4518,"contentIcons":4519,"contentSpecs":4520,"federalTopic":4521,"contentType":4477},"Weiterentwicklung der Dienstpflicht","/de/weiterentwicklung-dienstpflicht","Der Bundesrat hat Eckwerte zur Einführung einer Sicherheitsdienstpflicht beschlossen. Zivilschutz und Zivildienst sollen zu einem Katastrophenschutz fusioniert werden. ","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/4yifur677r0m/vbs-ddps-armee-alimentierung.jpg?rect=0%2C0%2C1920%2C1080&w=1024&auto=format","Dienstbüchlein","24. Juni",{"type":211,"date":4517},"2026-06-24T08:00:00.000Z",[],[],{},[4208],"doc-1jd5o6d0g2",{"properties":4524,"identifier":4296,"id":4526,"nestedContent":4527},{"sectionStyles":4525},{"section-variation":4295},"doc-1jd5o559l0",[4528],{"properties":4529,"identifier":4302,"id":4531,"nestedContent":4532},{"variation":4295,"anchorNavItems":4530},[],"doc-container-grid-1785908206902-788",[4533],{"properties":4534,"identifier":4312,"id":4537,"nestedContent":4538},{"idComponent":4535,"title":4536,"variant":4444,"link":4220},"teaser-grid-doc-1jd5o559l1","Arbeiten im VBS","doc-1jd5o559l1",[4539,4554,4568],{"properties":4540,"identifier":4368,"id":4553},{"title":4536,"slug":4541,"description":4542,"imageURL":4543,"imageAlt":4544,"teaserType":4358,"language":7,"date":4545,"metaInfo":4546,"isPublicationDateHidden":1809,"eventInfos":4220,"authors":4548,"contentIcons":4549,"contentSpecs":4550,"federalTopic":4551,"contentType":4492},"/de/arbeiten-im-vbs","Das VBS beschäftigt Menschen in über 200 verschiedenen Berufen. Dazu bietet es zahlreiche Lehrstellen und Hochschulpraktika an. Bei uns finden Sie attraktive Anstellungsbedingungen und eine positive Arbeitskultur.","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/ozGjAp3ZRpyn/vbs-ddps-arbeitgeber-kultur.jpg?rect=0%2C0%2C1920%2C1080&w=1024&auto=format","Kultur im VBS","13. Nov.",{"type":211,"date":4547},"2024-11-13T09:57:00.000Z",[],[],{},[4552],"100","doc-1jd5o559l2",{"properties":4555,"identifier":4368,"id":4567},{"title":4556,"slug":4557,"description":4558,"imageURL":4559,"imageAlt":4560,"teaserType":4358,"language":7,"date":4545,"metaInfo":4561,"isPublicationDateHidden":1809,"eventInfos":4220,"authors":4563,"contentIcons":4564,"contentSpecs":4565,"federalTopic":4566,"contentType":4492},"Werte, Führung und Zusammenarbeit","/de/werte-fuehrung-und-zusammenarbeit","Das VBS fördert eine Kultur der Führung und Zusammenarbeit, die auf Vertrauen, Respekt und gemeinsamen Werten basiert, um das Potenzial der Mitarbeitenden zu entfalten.","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/64I5JFaH74Ba/vbs-ddps-werte-de.jpg?rect=0%2C0%2C1920%2C1080&w=1024&auto=format","Offenheit, Respekt, Vertrauen, Mut und Weitsicht: Werte des VBS",{"type":211,"date":4562},"2024-11-13T10:28:00.000Z",[],[],{},[],"doc-1jd5o559l3",{"properties":4569,"identifier":4368,"id":4581},{"title":4570,"slug":4571,"description":4572,"imageURL":4573,"imageAlt":4574,"teaserType":4358,"language":7,"date":4545,"metaInfo":4575,"isPublicationDateHidden":1809,"eventInfos":4220,"authors":4577,"contentIcons":4578,"contentSpecs":4579,"federalTopic":4580,"contentType":4492},"Diversity im VBS","/de/diversity","Unsere Vielfalt bringt verschiedene Talente zusammen, die alle mit unterschiedlichen Fähigkeiten auf unser gemeinsames Ziel hinarbeiten – Sicherheit für die Schweiz.","https://prod-vbsch-hcms-sdweb.imgix.net/dam/de/sd-web/FTUmKmXEloDx/vbs-ddps-arbeitgeber-diversity.jpg?rect=0%2C0%2C1920%2C1080&w=1024&auto=format","Diversity",{"type":211,"date":4576},"2024-11-13T10:58:00.000Z",[],[],{},[4552],"doc-1jg7ehjuq0",[4583],{"tenantDocumentId":4584,"title":211,"documentId":4585,"documentType":4586,"contentType":4587,"language":7,"metadata":4588,"cookiepopup":4594},"ld_3524",3524,"article","cookie",{"language":4589,"jsonLDEntities":4591,"translationPages":4592,"contactDataInformation":4593},{"label":6,"locale":7,"groupId":4590},"syWuWxnVC5uitTc3mpffX",[],[],{},{"cookietext":4595,"accepttext":4596,"declinetext":4597},"Damit wir unser Webangebot optimal auf Ihre Bedürfnisse ausrichten können, verwenden wir das Analysetool Matomo. Dabei wird Ihr Verhalten auf der Website in anonymisierter Form erfasst. Es werden also keine personenbezogenen Daten übermittelt oder gespeichert. Wenn Sie damit nicht einverstanden sind, können Sie die Datenerfassung durch Matomo unterbinden und diese Website trotzdem ohne Einschränkungen nutzen. Weitere Informationen dazu finden Sie auf der Seite Rechtliches.","Einverstanden","Weiter ohne Datenerfassung",{"id":4599,"handle":4600,"title":4600,"current":1809,"linkTarget":4271,"type":211,"children":4601,"documentId":211},4638,"topbar-navigation-de",[4602,4609],{"id":4603,"handle":211,"title":4604,"current":1809,"link":4605,"linkTarget":4606,"type":4607,"children":4608,"documentId":211},"frULag15USL8r9ApVhjXJ","Behördeninformationen","https://www.ch.ch/","_blank","uri",[],{"id":4610,"handle":4600,"title":4611,"icon":4612,"link":4613,"current":1809,"linkTarget":4271,"type":211,"children":4614,"documentId":211},"easy-language-link-de","easyLang","EasyLanguage","/de/informationen-in-leichter-sprache",[],[4616,4649],{"tenantDocumentId":4617,"name":211,"language":7,"documentId":4618,"documentType":268,"contentType":4619,"translations":4620,"metadata":4639},"gd_89",89,"government",[4621,4626,4631,4635],{"locale":18,"metadata":4622},{"link":4623,"title":4624,"accronym":4625},"https://www.admin.ch/en","The Swiss Federal Council","FC",{"locale":12,"metadata":4627},{"link":4628,"title":4629,"accronym":4630},"https://www.admin.ch/fr","Le Conseil fédéral suisse","CF",{"locale":15,"metadata":4632},{"link":4633,"title":4634,"accronym":4630},"https://www.admin.ch/it","Il Consiglio federale svizzero",{"locale":286,"metadata":4636},{"link":4637,"title":4638,"accronym":4630},"https://www.admin.ch/rm","Il Cussegl federal svizzer",{"language":4640,"title":4641,"accronym":4642,"link":4643,"intranetLink":4643,"intranetCheckbox":19,"internetCheckbox":19,"nsb-project-handle":4644,"nsbEnabled":19,"onsb-id":4645,"jsonLDEntities":4646,"translationPages":4647,"contactDataInformation":4648},{"locale":7},"Der Schweizerische Bundesrat","BR","https://www.admin.ch","der-schweizerische-bundesrat","ORG-1070",[],[],{},{"tenantDocumentId":4650,"name":211,"language":7,"documentId":4651,"documentType":268,"contentType":4619,"translations":4652,"metadata":4672},"gd_90",90,[4653,4658,4663,4668],{"locale":18,"metadata":4654},{"link":4655,"title":4656,"accronym":4657},"https://www.bk.admin.ch/bk/en/home.html","The Swiss Federal Chancellery - the Federal Council's staff office","FCh",{"locale":12,"metadata":4659},{"link":4660,"title":4661,"accronym":4662},"https://www.bk.admin.ch/bk/fr/home.html","La Chancellerie fédérale suisse - l'état-major du Conseil fédéral","ChF",{"locale":15,"metadata":4664},{"link":4665,"title":4666,"accronym":4667},"https://www.bk.admin.ch/bk/it/home.html","La Cancelleria federale svizzera - lo Stato maggiore del Consiglio federale","CaF",{"locale":286,"metad