//www.linkedin.com/company/federal-department-of-defence-civil-protection-and-sports","Bleiben Sie informiert",{"furtherHeadline":5852},"Weitere Informationen",[],[],{},{"id":5857,"handle":5858,"title":5858,"current":1809,"linkTarget":4271,"type":211,"children":5859,"documentId":211},4639,"footer-navigation-de",[5860,5865,5871,5877],{"id":5861,"handle":211,"title":5862,"current":1809,"link":5863,"linkTarget":4606,"type":4607,"children":5864,"documentId":211},"K_dDEojjNmH9cpj9Ys1xQ","Rechtliches","https://www.admin.ch/gov/de/start/rechtliches.html",[],{"id":5866,"handle":211,"title":5867,"current":1809,"link":5868,"linkTarget":4271,"type":304,"children":5869,"documentId":5870},"4K3r4hVqqjuk17t94vF53","Impressum","/de/impressum-herausgeber",[],"675",{"id":5872,"handle":211,"title":5873,"current":1809,"link":5874,"linkTarget":4271,"type":304,"children":5875,"documentId":5876},"v8JEuV_K2s77OLGzvBFNZ","Barrierefreiheit","/de/barrierefreiheit-in-der-bundesverwaltung",[],"5149",{"id":5878,"handle":211,"title":5879,"current":1809,"link":5880,"linkTarget":4271,"type":304,"children":5881,"documentId":5882},"X3g2X3rdMMwYIzVaCzOCT","Netiquette","/de/netiquette-des-vbs",[],"3827",{"id":5884,"handle":5885,"title":5885,"current":1809,"linkTarget":4271,"type":211,"children":5886,"documentId":211},4640,"footer-menu-de",[5887,5892,5896,5899,5902],{"id":5888,"handle":211,"title":5889,"current":1809,"link":5890,"linkTarget":4606,"type":4607,"children":5891,"documentId":211},"P8tMQPYXYpXVM-CzQXw9e","E-Rechnung","http://www.e-rechnung.admin.ch/",[],{"id":5893,"handle":211,"title":5894,"current":1809,"link":5788,"linkTarget":4271,"type":304,"children":5895,"documentId":5793},"sC6DsqTWvkfP458VQsJ0z","Zugang amtliche Dokumente",[],{"id":5897,"handle":211,"title":5490,"current":1809,"link":5491,"linkTarget":4271,"type":304,"children":5898,"documentId":5493},"uUZKGvznhXeFou5-vLJ5z",[],{"id":5900,"handle":211,"title":4269,"current":1809,"link":4270,"linkTarget":4271,"type":304,"children":5901,"documentId":5374},"XtX607i97zNg2EjTdP4O0",[],{"id":5903,"handle":211,"title":5502,"current":1809,"link":4482,"linkTarget":4271,"type":304,"children":5904,"documentId":2586},"RfuWg7Uk-8YsLMHNs9tsY",[],{"projectId":299,"document":5906,"topics":5984,"publishers":5987,"coPublishers":5989,"contactData":5991},{"about":5907,"informed":5908,"furtherinformation":5910,"metadata":5911,"contentType":5920,"content":5921},{},{"socialLinks":5909},[],{},{"title":4392,"translationPages":5912,"contactDataInformation":5917,"publishDate":5918,"significantPublicationDate":5918,"newsLocation":4234,"easyLanguagePage":-1,"signLanguagePage":-1,"announcementDate":5919},[5913,5915],{"lang":15,"slug":5914,"code":15},"/it/newnsb/5bBC1HPXGI21",{"lang":12,"slug":5916,"code":12},"/fr/newnsb/5bBC1HPXGI21",{},"2026-08-04T10:00:00.000Z","2026-08-04T00:00:00.000Z","nsb-complex-news-page",[5922,5939],{"identifier":5923,"id":5924,"properties":5925,"nestedContent":5938},"lead-contentpage","doc-1j8q68dc80",{"nestedContent":5926,"type":5934,"dateInfo":5935,"metaInfoType":5936},[5927,5930],{"identifier":4256,"id":5928,"properties":5929},"doc-1j8q68dc81",{"label":4392,"heading":4252},{"identifier":4260,"id":5931,"properties":5932},"doc-1j8q68dc90",{"text":5933},"Bern, 04.08.2026 — Das Eidgenössische Departement für Verteidigung, Bevölkerungsschutz und Sport (VBS) hat den Cybervorfall bei einer US-Tochtergesellschaft der RUAG MRO sowie den Umgang des Unternehmens mit dem Vorfall überprüft. Die Untersuchung kommt zum Schluss, dass der Entscheid der RUAG MRO zur Zahlung eines Lösegelds im Rahmen ihrer unternehmerischen Verantwortung getroffen wurde und keine Anhaltspunkte für eine Rechtsverletzung bestehen. Gleichzeitig zeigt die Prüfung Verbesserungspotenzial bei der gesamtheitlichen Risikoabwägung und beim Informationsfluss gegenüber dem Bund als Eigner auf. Das VBS hat entsprechende Empfehlungen ausgesprochen und weitere Massnahmen eingeleitet, die rasch umgesetzt werden.","detail",{"publicationDate":5918,"significantPublicationDate":5918},{"name":5937},"newsCategories.medienmitteilung",[5927,5930],{"identifier":4296,"properties":5940},{"sectionStyles":5941,"nestedContent":5942},{},[5943],{"identifier":4302,"properties":5944},{"variation":5945,"anchorNavItems":5946,"nestedContent":5947},"center--xs",[],[5948,5952,5956,5960,5964,5968,5972,5976,5980],{"identifier":4260,"id":5949,"properties":5950},"doc-1j8q69j7r0",{"text":5951},"Am 9. und 10. Oktober 2025 wurde bei der RUAG LLC, einer Tochtergesellschaft der RUAG MRO Holding AG, ein Ransomware-Angriff der Hackergruppe AKIRA festgestellt. Im Auftrag des Chefs des Eidgenössischen Departements für Verteidigung, Bevölkerungsschutz und Sport (VBS) hat das VBS den Cybervorfall aufgearbeitet. Dabei wurde insbesondere geprüft, ob das Unternehmen mit dem Entscheid zur Zahlung eines Lösegelds rechtskonform gehandelt und seine Pflichten gegenüber dem Bund als Eigner eingehalten hat.",{"identifier":4260,"id":5953,"properties":5954},"doc-1jv5rfklt0",{"text":5955},"Die Untersuchung zeigt, dass die RUAG MRO die Rechtskonformität einer Lösegeldzahlung nach anwendbarem US-Recht vor der Zahlung geprüft hat. Als privatrechtlich organisierte Aktiengesellschaft trägt die RUAG MRO die Verantwortung für ihre operativen Geschäftsentscheide. Der Entscheid über die Zahlung des Lösegelds lag somit in der Zuständigkeit der Unternehmensorgane. Eine vorgängige Zustimmung des Bundes als Eigner war daher nicht erforderlich.",{"identifier":4260,"id":5957,"properties":5958},"doc-1jv5rfklu0",{"text":5959},"Die Untersuchung hält gleichzeitig fest, dass eine koordinierte Information gegenüber dem Bund als Eigner angebracht gewesen wäre. Die strategischen Ziele des Bundesrats für die RUAG MRO sehen eine Information des Eigners vor einer öffentlichen Kommunikation vor.",{"identifier":4260,"id":5961,"properties":5962},"doc-1jv5rfklv0",{"text":5963},"Die Prüfung zeigt ferner, dass die dem Entscheid zugrunde liegende Chancen- und Risikoabwägung der RUAG MRO schwergewichtig auf rechtliche und ökonomische Überlegungen ausgerichtet war. Nach Einschätzung des VBS wurden politische und reputationsbezogene Auswirkungen sowie weitere übergeordnete Interessen nicht ausreichend berücksichtigt. Das VBS erwartet von der RUAG MRO, dass diese Aspekte stärker in die Abwägung einbezogen werden.",{"identifier":4260,"id":5965,"properties":5966},"doc-1jv5rfkm00",{"text":5967},"Die RUAG MRO hat den Vorfall ihrerseits analysiert und verschiedene Verbesserungsmassnahmen eingeleitet. Sie arbeitet daran, die von ihr selbst erkannten Schwachstellen (Eskalationsprozesse bei den Tochtergesellschaften, Informatik-Governance unter Einbezug des Informatikverantwortlichen der RUAG MRO, Prozesse der Krisenkommunikation und Mindestanforderungen an die Informatiksicherheit) zu beheben. Das VBS begrüsst diese Massnahmen und hat die RUAG MRO beauftragt, deren Umsetzung weiterzuführen und den Eignerstellen GS-VBS und EFV darüber Bericht zu erstatten.",{"identifier":4260,"id":5969,"properties":5970},"doc-1jv5rfkm01",{"text":5971},"Um vergleichbare Situationen künftig zu vermeiden, hat der Bund als Eigner zusätzliche Empfehlungen an die RUAG MRO ausgesprochen. So soll die RUAG MRO gemeinsam mit dem Bundesamt für Cybersicherheit (BACS) ihre Schutzmassnahmen und Prozesse überprüfen, allfällige Schwachstellen beheben und die Widerstandsfähigkeit gegenüber Cyberangriffen weiter stärken. Dabei soll auch beurteilt werden, ob die RUAG MRO insgesamt angemessen gegen Cybervorfälle geschützt ist.",{"identifier":4260,"id":5973,"properties":5974},"doc-1jv5rfkm10",{"text":5975},"Die Eignerstellen weisen die RUAG auf die Informationspflichten zu einer frühzeitigen und sachgerechten Information gemäss den strategischen Zielen hin. Zudem sind die Eignerstellen angehalten, sich frühzeitig aktiv in die Aufarbeitung solcher Fälle einzubringen.",{"identifier":4260,"id":5977,"properties":5978},"doc-1jv5rfkm11",{"text":5979},"Aufgrund der Ergebnisse der Untersuchung sieht das VBS keinen Anlass für weitergehende eigentumsrechtliche Massnahmen gegenüber der RUAG MRO. Mit den ausgesprochenen Empfehlungen und den eingeleiteten Massnahmen sollen die Lehren aus dem Vorfall umgesetzt und die Resilienz der RUAG MRO gegenüber künftigen Cybervorfällen gestärkt werden.",{"identifier":4260,"id":5981,"properties":5982},"doc-1jv5rfkm20",{"text":5983},"Das VBS und der Bund halten unverändert an ihrer Empfehlung fest, im Falle von Cyber-Angriffen kein Lösegeld zu bezahlen.",[5985,5986],"395","558",[5988],"5",[5990],"19",[5992],"gd_849",["Reactive",5994],{},["Set",5996],"$3oRWNoOsuN",["ShallowReactive",5998],{"$fHKlZIzz-n59oKhO-_u3WU1e5ZoS-GPX_S-nwT3vQCsM":-1,"$fwufl64AudrT5sk9lvps602O4DXrlcF37gGcqLnmIWRY":-1,"index/data-records/office/de-all.json":-1,"index/data-records/department/de-all.json":-1,"index/data-records/government/de-all.json":-1,"index/data-records/site-identity/de-all.json":-1,"index/homepages/de-all.json":-1,"index/cookiepopup/de-all.json":-1,"main-menus/main-de.json":-1,"meta-navigation-menus/meta-navigation-de.json":-1,"topbar-navigation-menus/topbar-navigation-de.json":-1,"document_group_nnsb_5bBC1HPXGI21":-1,"topics_de_":-1,"organisations_de_":-1,"contacts_de__":-1,"footer-data-de":-1,"index/data-records/footer-data/de-all.json":-1,"footer-nav-menu-de":-1,"footer-navigation-menus/footer-navigation-de.json":-1,"footer-menu-de":-1,"footer-menus/footer-menu-de.json":-1},["Reactive",6000],{"siteIdentity":6001,"header":6002,"menu":6020,"cookiepopup":6478},{"siteIdentity":4112},{"headerDepartmentData":6003,"headerGovernmentData":6006,"headerOfficeData":6009,"pageTranslations":6012,"accessibilityLinks":6014,"pageContentType":6017,"accessibilityType":6018},["Ref",6004],["Reactive",6005],[3935,3964,3992,4022,4049,4075,4104],["Ref",6007],["Reactive",6008],[4639,4672],["Ref",6010],["Reactive",6011],[289,343,384,417,447,482,518,548,578,608,648,682,719,749,780,811,842,873,910,941,978,1005,1035,1061,1093,1123,1158,1189,1222,1255,1288,1321,1340,1368,14