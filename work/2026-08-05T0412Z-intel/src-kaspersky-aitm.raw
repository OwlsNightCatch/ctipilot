        <script type="text/javascript">
            (function () {
                var commentField = document.getElementById('comment');
                var wrapper = document.getElementById('kaspersky-smart-captcha-wrapper');
                if (!commentField || !wrapper) {
                    return;
                }

                var shown = false;
                var showCaptcha = function () {
                    if (shown) {
                        return;
                    }
                    if (commentField.value.trim().length > 0) {
                        wrapper.style.display = 'block';
                        shown = true;
                    }
                };

                commentField.addEventListener('input', showCaptcha);
                commentField.addEventListener('focus', showCaptcha);
            })();
        </script>
