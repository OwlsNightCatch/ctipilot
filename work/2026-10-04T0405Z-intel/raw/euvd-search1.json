nisaIdProduct":[{"id":"2d340904-065b-3985-8967-205e7cbd83a1","product":{"name":"Apache Thrift","vendor":{"name":"Apache Software Foundation"}},"product_version":"0 \u003c0.25.0"}],"enisaIdVendor":[{"id":"4f07e65c-1296-3ddd-9d5b-34af9730e837","vendor":{"name":"Apache Software Foundation"}}]},{"id":"EUVD-2026-91367","enisaUuid":"26377c03-5af4-33b8-8acf-17dcafb5c8ec","description":"Missing release of memory after effective lifetime, Missing release of resource after effective lifetime vulnerability in Apache Thrift THeaderTransport.\n\n\n\nThis issue affects Apache Thrift: before 0.25.0.\n\n\n\nUsers are recommended to upgrade to version 0.25.0, which fixes the issue.","datePublished":"Oct 2, 2026, 10:13:55 AM","dateUpdated":"Oct 2, 2026, 10:56:42 AM","baseScore":8.7,"baseScoreVersion":"4.0","baseScoreVector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","references":"https://lists.apache.org/thread/33otcgbqd27wf6qq810q56znzbomnhg1\nhttps://lists.apache.org/thread/9353rb8mpoq4ltff88h1j2y3hfy6blgb\n","aliases":"CVE-2026-93926\nGHSA-qqwh-ph69-26jv\n","assigner":"apache","epss":0.43,"enisaIdProduct":[{"id":"8d480794-7d56-3a49-8caa-1aa8b60637d7","product":{"name":"Apache Thrift","vendor":{"name":"Apache Software Foundation"}},"product_version":"0 \u003c0.25.0"}],"enisaIdVendor":[{"id":"d33ec983-1f49-314f-a532-8bf3c9df54dc","vendor":{"name":"Apache Software Foundation"}}]},{"id":"EUVD-2026-91369","enisaUuid":"92efa7b0-71e5-329f-9ddb-5cc274382fcd","description":"Stack-based buffer overflow, Incorrect bitwise shift of integer vulnerability in Apache Thrift C++ THeaderProtocol.\n\n\n\nThis issue affects Apache Thrift: before 0.25.0.\n\n\n\nUsers are recommended to upgrade to version 0.25.0, which fixes the issue.","datePublished":"Oct 2, 2026, 10:16:17 AM","dateUpdated":"Oct 2, 2026, 10:53:48 AM","baseScore":8.7,"baseScoreVersion":"4.0","baseScoreVector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","references":"https://lists.apache.org/thread/33otcgbqd27wf6qq810q56znzbomnhg1\nhttps://lists.apache.org/thread/b4rrkrwoyqb9g7hk58d3fx09cbvp1tg9\n","aliases":"GHSA-4884-wghm-c634\nCVE-2026-93925\n","assigner":"apache","epss":0.46,"enisaIdProduct":[{"id":"9272fb8d-7ed9-3840-b36c-319582b40b9b","product":{"name":"Apache Thrift","vendor":{"name":"Apache Software Foundation"}},"product_version":"0 \u003c0.25.0"}],"enisaIdVendor":[{"id":"559111b0-c75d-3fa8-b529-96af6bb5f220","vendor":{"name":"Apache Software Foundation"}}]},{"id":"EUVD-2026-91371","enisaUuid":"6b57f3e5-bc20-36a2-8f17-51b6216a0e3e","description":"A stack-based buffer overflow vulnerability exists in protocol gateways\u0027 account management interface. The vulnerability is caused by insufficient length validation of the `account_name` parameter when processing account management requests. An attacker authenticated as a read-only user to the web management interface could supply a specially crafted account name that exceeds the size of the internal stack buffer, resulting in corruption of program execution flow. Successful exploitation could allow an attacker to read sensitive information from device memory, including credentials, modify arbitrary memory contents, and disrupt device availability.","datePublished":"Oct 2, 2026, 10:18:29 AM","dateUpdated":"Oct 2, 2026, 10:49:43 AM","baseScore":9.4,"baseScoreVersion":"4.0","baseScoreVector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:H/SI:H/SA:H","references":"https://www.moxa.com/en/support/product-support/security-advisory/mpsa-269540-cve-2026-86325,-cve-2026-86326-two-vulnerabilities-in-protocol-gateways\n","aliases":"CVE-2026-86325\nGHSA-gf54-rrcc-vgxp\n","assigner":"Moxa","epss":0.34,"enisaIdProduct":[{"id":"a62aceeb-446a-36de-8e57-7447868325e8","product":{"name":"MGate MB3270 Series","vendor":{"name":"Moxa"}},"product_version":"1.0 ≤4.7"},{"id":"d57fb9b2-a59d-3419-aa44-6ee28db03b94","product":{"name":"MGate MB3170 Series","vendor":{"name":"Moxa"}},"product_version":"1.0 ≤4.7"}],"enisaIdVendor":[{"id":"03c69237-91d9-391e-bf11-36fc82dbbb4b","vendor":{"name":"Moxa"}}]},{"id":"EUVD-2026-91372","enisaUuid":"5e4d570a-2c83-365f-a68d-881c30948aba","description":"Improper validation of specified quantity in input, Allocation of resources without limits or throttling, Excessive Iteration vulnerability in Apache Thrift PHP bindings.\n\n\n\nThis issue affects Apache Thrift: before 0.25.0.\n\n\n\nUsers are recommended to upgrade to version 0.25.0, which fixes the issue.","datePublished":"Oct 2, 2026, 10:18:38 AM","dateUpdated":"Oct 2, 2026, 10:44:20 AM","baseScore":8.7,"baseScoreVersion":"4.0","baseScoreVector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","references":"https://lists.apache.org/thread/33otcgbqd27wf6qq810q56znzbomnhg1\nhttps://lists.apache.org/thread/bf12g1b11r4x9x3wsy4mgwfgd0t779h7\n","aliases":"CVE-2026-91137\nGHSA-r276-xrw4-gpgm\n","assigner":"apache","epss":0.43,"enisaIdProduct":[{"id":"0a20bd98-34ab-36c4-b41d-8047db401518","product":{"name":"Apache Thrift","vendor":{"name":"Apache Software Foundation"}},"product_version":"0 \u003c0.25.0"}],"enisaIdVendor":[{"id":"f2d6156a-694c-3082-b0ec-57394f70978d","vendor":{"name":"Apache Software Foundation"}}]},{"id":"EUVD-2026-91401","enisaUuid":"5fa6beca-7130-3fc7-ab61-900b65b54e7e","description":"Improper handling of length parameter inconsistency, Uncaught exception, Inefficient Algorithmic Complexity, Memory allocation with excessive size value, Initialization of a resource with an insecure default vulnerability in Apache Thrift Python, Ruby, Erlang, Lua, Dart, JavaME, Perl, PHP and D language bindings.\n\n\n\nThis issue affects Apache Thrift: before 0.25.0.\n\n\n\nUsers are recommended to upgrade to version 0.25.0, which fixes the issue.","datePublished":"Oct 2, 2026, 10:42:44 AM","dateUpdated":"Oct 2, 2026, 10:42:44 AM","baseScore":8.7,"baseScoreVersion":"4.0","baseScoreVector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","references":"https://lists.apache.org/thread/33otcgbqd27wf6qq810q56znzbomnhg1\nhttps://lists.apache.org/thread/rm0m34gt6fh1flvt16wty559hfg191qr\n","aliases":"CVE-2026-85494\nGHSA-26jj-r8fx-8pm3\n","assigner":"apache","epss":0.43,"enisaIdProduct":[{"id":"2c54f051-82af-3e30-8263-3b27616dde82","product":{"name":"Apache Thrift","vendor":{"name":"Apache Software Foundation"}},"product_version":"0 \u003c0.25.0"}],"enisaIdVendor":[{"id":"b60fde0f-3f0b-33e9-86cd-79652c33b368","vendor":{"name":"Apache Software Foundation"}}]},{"id":"EUVD-2026-91373","enisaUuid":"66517f14-76f5-380c-bdf4-5f5e901b9ed7","description":"An improper verification of cryptographic signature vulnerability exists in protocol gateways because the device does not properly verify the cryptographic authenticity of firmware images before installation. An attacker with high privileges and access to the firmware update interface could provide a specially crafted or modified firmware image, causing it to be installed on the device. Successful exploitation could allow the attacker to execute unauthorized code, compromise the integrity and availability of the device, and persist malicious modifications across subsequent firmware updates.","datePublished":"Oct 2, 2026, 10:21:56 AM","dateUpdated":"Oct 2, 2026, 10:39:59 AM","baseScore":8.6,"baseScoreVersion":"4.0","baseScoreVector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:H/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","references":"https://www.moxa.com/en/support/product-support/security-advisory/mpsa-269540-cve-2026-86325,-cve-2026-86326-two-vulnerabilities-in-protocol-gateways\n","aliases":"GHSA-pccp-468g-6mp8\nCVE-2026-86326\n","assigner":"Moxa","epss":0.19,"enisaIdProduct":[{"id":"77b2a346-7aca-3c31-bf14-e839ac37315f","product":{"name":"MGate MB3170 Series","vendor":{"name":"Moxa"}},"product_version":"1.0"},{"id":"dad25211-906e-3a9b-a39c-50c2625ba37a","product":{"name":"MGate MB3270 Series","vendor":{"name":"Moxa"}},"product_version":"1.0"}],"enisaIdVendor":[{"id":"e880d852-7399-3bc8-9db6-d5c70fe9429e","vendo