":\"\",\"form_template_ids\":[],\"required_tag_groups\":[],\"category_types\":{\"discussion\":{\"id\":\"discussion\",\"name\":\"Discussion\",\"title\":\"discussion\",\"description\":\"A standard category with all the essentials for conversation.\",\"icon\":\"memo\",\"svg_icon\":\"comment\",\"available\":true,\"visible\":true,\"configuration_schema\":{}}},\"uploaded_logo\":{\"id\":69535,\"url\":\"//cdck-file-uploads-us1.s3.dualstack.us-west-2.amazonaws.com/elastic/original/3X/0/3/037787725d3beae389633ed26a52fd81961f1b05.png\",\"width\":320,\"height\":320},\"uploaded_logo_dark\":null,\"uploaded_background\":null,\"uploaded_background_dark\":null,\"can_edit\":false},{\"id\":82,\"name\":\"Elastic Observability\",\"color\":\"0088CC\",\"text_color\":\"FFFFFF\",\"style_type\":\"square\",\"icon\":null,\"emoji\":null,\"slug\":\"observability\",\"topic_count\":677,\"post_count\":2067,\"position\":10,\"description\":\"Bring your \\u003ca href=\\\"https://www.elastic.co/log-monitoring\\\"\\u003elogs\\u003c/a\\u003e, \\u003ca href=\\\"https://www.elastic.co/infrastructure-monitoring\\\"\\u003einfrastructure\\u003c/a\\u003e and \\u003ca href=\\\"https://www.elastic.co/uptime-monitoring\\\"\\u003eavailability\\u003c/a\\u003e metrics, and \\u003ca href=\\\"https://www.elastic.co/apm\\\"\\u003eAPM traces\\u003c/a\\u003e together at scale in a single stack so you can monitor and react to events happening anywhere in your environment. And it's free and open.\",\"description_text\":\"Bring your logs, infrastructure and availability metrics, and APM traces together at scale in a single stack so you can monitor and react to events happening anywhere in your environment. And it\\u0026#39;s free and open.\",\"description_excerpt\":\"Bring your \\u003ca href=\\\"https://www.elastic.co/log-monitoring\\\"\\u003elogs\\u003c/a\\u003e, \\u003ca href=\\\"https://www.elastic.co/infrastructure-monitoring\\\"\\u003einfrastructure\\u003c/a\\u003e and \\u003ca href=\\\"https://www.elastic.co/uptime-monitoring\\\"\\u003eavailability\\u003c/a\\u003e metrics, and \\u003ca href=\\\"https://www.elastic.co/apm\\\"\\u003eAPM traces\\u003c/a\\u003e together at scale in a single stack so you can monitor and react to events happening anywhere in your environment. And it\\u0026#39;s free and open.\",\"topic_url\":\"/t/about-the-elastic-observability-category/235255\",\"read_restricted\":false,\"permission\":null,\"notification_level\":1,\"topic_template\":\"\",\"topic_title_placeholder\":null,\"has_children\":true,\"subcategory_count\":null,\"sort_order\":\"\",\"sort_ascending\":null,\"show_subcategory_list\":false,\"num_featured_topics\":3,\"default_view\":\"\",\"subcategory_list_style\":\"rows_with_featured_topics\",\"default_top_period\":\"all\",\"default_list_filter\":\"all\",\"minimum_required_tags\":0,\"navigate_to_first_post_after_read\":false,\"custom_fields\":{\"has_chat_enabled\":null,\"enable_unassigned_filter\":null,\"additional_assign_allowed_on_groups\":null,\"doc_categories_documentation\":null,\"sort_topics_by_event_start_date\":null,\"disable_topic_resorting\":null,\"create_as_post_voting_default\":null,\"only_post_voting_in_this_category\":null,\"enable_accepted_answers\":null,\"enable_shared_issues\":null,\"enable_topic_voting\":null,\"notify_on_staff_accept_solved\":\"false\",\"empty_box_on_unsolved\":\"false\"},\"allow_global_tags\":true,\"read_only_banner\":\"\",\"form_template_ids\":[],\"required_tag_groups\":[],\"category_types\":{\"discussion\":{\"id\":\"discussion\",\"name\":\"Discussion\",\"title\":\"discussion\",\"description\":\"A standard category with all the essentials for conversation.\",\"icon\":\"memo\",\"svg_icon\":\"comment\",\"available\":true,\"visible\":true,\"configuration_schema\":{}}},\"uploaded_logo\":{\"id\":69533,\"url\":\"//cdck-file-uploads-us1.s3.dualstack.us-west-2.amazonaws.com/elastic/original/3X/e/e/eed1fc72d73b654da75aa11d7ff532faa291198a.png\",\"width\":320,\"height\":320},\"uploaded_logo_dark\":null,\"uploaded_background\":null,\"uploaded_background_dark\":null,\"can_edit\":false},{\"id\":58,\"name\":\"APM\",\"color\":\"0088CC\",\"text_color\":\"FFFFFF\",\"style_type\":\"square\",\"icon\":null,\"emoji\":null,\"slug\":\"apm\",\"topic_count\":3502,\"post_count\":15617,\"position\":11,\"description\":\"Already housing logs and system metrics in Elasticsearch? Expand to application metrics with free and open Elastic APM. See exactly where your application is spending time so you can quickly fix issues and feel good about the code you push.\",\"description_text\":\"Already housing logs and system metrics in Elasticsearch? Expand to application metrics with free and open Elastic APM. See exactly where your application is spending time so you can quickly fix issues and feel good about the code you push.\",\"description_excerpt\":\"Already housing logs and system metrics in Elasticsearch? Expand to application metrics with free and open Elastic APM. See exactly where your application is spending time so you can quickly fix issues and feel good about the code you push.\",\"topic_url\":\"/t/about-the-apm-category/97348\",\"read_restricted\":false,\"permission\":null,\"parent_category_id\":82,\"notification_level\":1,\"topic_template\":\"If you are asking about a problem you are experiencing, please use the following template, as it will help us help you. If you have a different problem, please delete all of this text :)\\n\\nTIP 1: select at least one tag that further categorizes your topic. For example `server` for APM Server related questions, `java` for questions regarding the Elastic APM Java agent, or `ui` for questions about the APM App within Kibana.\\n\\nTIP 2: Check out the [troubleshooting guide](https://www.elastic.co/guide/en/apm/get-started/current/troubleshooting.html) first. Not only will it help you to resolve common problems faster but it also explains in more detail which information we need before we can properly help you.\\n\\n**Kibana version**:\\n\\n**Elasticsearch version**:\\n\\n**APM Server version**:\\n\\n**APM Agent language and version**:\\n\\n**Browser version**:\\n\\n**Original install method (e.g. download page, yum, deb, from source, etc.) and version**:\\n\\n**Fresh install or upgraded from other version?**\\n\\n**Is there anything special in your setup?** For example, are you using the Logstash or Kafka outputs? Are you using a load balancer in front of the APM Servers? Have you changed index pattern, generated custom templates, changed agent configuration etc.\\n\\n**Description of the problem including expected versus actual behavior. Please include screenshots (if relevant)**:\\n\\n**Steps to reproduce**:\\n 1.\\n 2.\\n 3.\\n\\n**Errors in browser console (if relevant)**:\\n\\n**Provide logs and/or server output (if relevant)**:\\n\",\"topic_title_placeholder\":null,\"has_children\":false,\"subcategory_count\":null,\"sort_order\":\"\",\"sort_ascending\":null,\"show_subcategory_list\":false,\"num_featured_topics\":3,\"default_view\":\"latest\",\"subcategory_list_style\":\"rows_with_featured_topics\",\"default_top_period\":\"all\",\"default_list_filter\":\"all\",\"minimum_required_tags\":0,\"navigate_to_first_post_after_read\":false,\"custom_fields\":{\"has_chat_enabled\":null,\"enable_unassigned_filter\":null,\"additional_assign_allowed_on_groups\":null,\"doc_categories_documentation\":null,\"sort_topics_by_event_start_date\":null,\"disable_topic_resorting\":null,\"create_as_post_voting_default\":null,\"only_post_voting_in_this_category\":null,\"enable_shared_issues\":null,\"enable_topic_voting\":null,\"enable_accepted_answers\":\"true\",\"notify_on_staff_accept_solved\":\"false\",\"empty_box_on_unsolved\":\"false\"},\"allow_global_tags\":true,\"read_only_banner\":\"\",\"form_template_ids\":[],\"required_tag_groups\":[{\"min_count\":1}],\"category_types\":{\"discussion\":{\"id\":\"discussion\",\"name\":\"Discussion\",\"title\":\"discussion\",\"description\":\"A standard category with all the essentials for convers