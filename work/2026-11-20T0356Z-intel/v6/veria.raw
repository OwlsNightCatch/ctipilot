75 0 0 0 0-1.5z" clip-rule="evenodd" /></svg> </a> </li> </ul> </div> </footer></page-footer> </page-content> <script>
  // Official Cal.com embed loader — queues Cal() calls until embed.js arrives.
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar)
    }
    let d = C.document
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal
        let ar = arguments
        if (!cal.loaded) {
          cal.ns = {}
          cal.q = cal.q || []
          d.head.appendChild(d.createElement("script")).src = A
          cal.loaded = true
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments)
          }
          const namespace = ar[1]
          api.q = api.q || []
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api
            p(cal.ns[namespace], ar)
            p(cal, ["initNamespace", namespace])
          } else p(cal, ar)
          return
        }
        p(cal, ar)
      }
  })(window, "https://verialabs.cal.com/embed/embed.js", "init")

  Cal("init", "intro", { origin: "https://verialabs.cal.com" })
  Cal.ns.intro("ui", { hideEventTypeDetails: false, layout: "month_view" })

  // embed.js's [data-cal-link] click handler doesn't preventDefault, so our
  // anchor fallback hrefs would also navigate. This listener registers before
  // embed.js loads, so it runs first; preventDefault doesn't stop propagation,
  // so Cal's handler still opens the modal.
  document.addEventListener("click", (e) => {
    const el =
      e.target instanceof Element ? e.target.closest("[data-cal-link]") : null
    if (!(el instanceof HTMLElement)) return
    e.preventDefault()
    // Follow the site's theme toggle, not just the OS preference.
    const theme = document.documentElement.dataset.theme
    if (theme === "light" || theme === "dark") {
      el.dataset.calConfig = JSON.stringify({ theme, layout: "month_view" })
    }
  })
</script> <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092" integrity="sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==" data-cf-beacon='{"version":"2024.11.0","token":"5b25cca0cf9d4980a42fd25f78d532ec","spa":2}' crossorigin="anonymous"></script>
