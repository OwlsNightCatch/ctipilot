          </span>
        </p>
        <p class="ibm-btn-row" key="3">
          <input type="submit" :value="page==='download'?'Download':'Get feed'" name="ibm-submit"
            class="ibm-btn-pri">
        </p>
      </transition-group>
      <input v-if="useMyProducts" type="hidden" name="q45" :value="productSynkeys">
      <input type="hidden" name="type" :value="page">
      <input type="hidden" name="format" value="xml">
