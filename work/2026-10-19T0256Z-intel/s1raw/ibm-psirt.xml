          </div>
          <div v-if="product.moreInfoLinks.length &gt; 1" class="ibm-padding-bottom-1">
            <h3 class="ibm-h4 ibm-light ibm-padding-top-0 ibm-padding-bottom-0">More information:</h3>
            <ul class="ibm-link-list ibm-padding-top-0_5 ibm-padding-bottom-0">
              <li v-for="(link, lindex) in product.moreInfoLinks" :key="link.uri" class="ibm-ind-link">
              <a class="ibm-forward-em-link" :href="link.uri">
                {{ link.title && link.title.trim() || link.uri }}
              </a>
              </li>
            </ul>
          </div>
          <div v-else-if="product.moreInfoLinks.length === 1" class="ibm-padding-bottom-1">
            <h3 v-if="(product.moreInfoLinks[0].title && product.moreInfoLinks[0].title.trim())" class="ibm-h4 ibm-light ibm-padding-top-0 ibm-margin-bottom-0">More information:</h3>
            <p class="ibm-ind-link ibm-margin-top-0 ibm-padding-bottom-0">
            <a class="ibm-forward-em-link" :href="product.moreInfoLinks[0].uri">
              {{ product.moreInfoLinks[0].title && product.moreInfoLinks[0].title.trim() || "More information" }}
            </a>
          </div>
          <p class="ibm-item-note-alternate">Last updated: {{ product.lastUpdated }}.</p>
        </div>
      </div>
      <div v-if="index < products.length - 1" class="ibm-rule"><hr/></div>
