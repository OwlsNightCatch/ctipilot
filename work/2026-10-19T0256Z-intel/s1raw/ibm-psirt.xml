                {{ product.gaAnnLtr }}
              </a>
            </dd>
          </dl>
          <dl v-if="product.eomDate" class="ibm-col-4-1 ibm-col-medium-4-2 ibm-padding-top-0_5">
            <dt>End of marketing (EOM)</dt>
            <dd>
              {{ product.eomDate + (product.eomAnnLtr ? ', ' : '') }}
              <a v-if="product.eomAnnLtr"
                :href="annLtrUrl(product.eomAnnLtr)"
                title="View EOM announcement letter">
                {{ product.eomAnnLtr }}
              </a>
            </dd>
          </dl>
          <dl v-if="product.eosDate" class="ibm-col-4-1 ibm-col-medium-4-2 ibm-padding-top-0_5">
            <dt>Publish Date</dt>
            <dd>
              {{ product.eosDate + (product.eosAnnLtr ? ', ' : '') }}
              <a v-if="product.eosAnnLtr"
                :href="annLtrUrl(product.eosAnnLtr)"
