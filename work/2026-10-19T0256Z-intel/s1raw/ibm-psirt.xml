        :to="$root.routerLink('overview')">search for some products</router-link>.</span></p>
    <template v-for="(product, index) in products">
      <div class="ibm-columns ibm-padding-bottom-1">
        <h2 class="ibm-col-1-1 ibm-h4" title="Product name">{{ product.fullName }} {{ product.vrm }}</h2>
