er":false,"customerActionRequired":true,"customerActionRequiredId":1,"cweDetailsList":[{"keys":["cwe","cweUrl"],"values":["CWE-122: Heap-based Buffer Overflow","https://cwe.mitre.org/data/definitions/122.html"]}],"articles":[{"articleType":"FAQ","description":"<p><strong>According to the CVSS metric, user interaction is required (UI:R). What interaction would the user have to do?</strong></p>\n<p>An attacker must send a user a malicious Office file and convince them to open it.</p>\n","ordinal":10000},{"title":"Microsoft Office Outlook Remote Code Execution Vulnerability","articleType":"100000000","description":"<p>Heap-based buffer overflow in Microsoft Office Outlook allows an unauthorized attacker to execute code locally.</p>\n","ordinal":10000}],"revisions":[{"cveNumber":"CVE-2026-70125","version":1.2,"revisionDate":"2026-09-30T07:00:00-07:00","initialDate":"0001-01-01T00:00:00Z","description":"<p>CWE added. Informational change only.</p>\n","unformattedDescription":"CWE added. Informational change only.","notificationNeeded":false,"notificationSent":false,"sourceId":"06f38d92-e1bc-f111-aaae-000d3a325add"},{"cveNumber":"CVE-2026-70125","version":1,"revisionDate":"2026-09-23T07:00:00-07:00","initialDate":"0001-01-01T00:00:00Z","description":"<p>Information published.</p>\n","unformattedDescription":"Information published.","notificationNeeded":false,"notificationSent":false,"sourceId":"648956ed-95b7-f111-93a1-000d3ac5fb71"},{"cveNumber":"CVE-2026-70125","version":1.1,"revisionDate":"2026-09-23T07:00:00-07:00","initialDate":"0001-01-01T00:00:00Z","description":"<p>Information published. This CVE was addressed by updates that were released in September 2026, but the CVE was inadvertently omitted from the September 2026 Security Updates. This is an informational change only. Customers who have already installed the September 2026 updates do not need to take any further action.</p>\n","unformattedDescription":"Information published. This CVE was addressed by updates that were released in September 2026, but the CVE was inadvertently omitted from the September 2026 Security Updates. This is an informational change only. Customers who have already installed the September 2026 updates do not need to take any further action.","notificationNeeded":false,"notificationSent":false,"sourceId":"f2ce37bc-98b7-f111-93fe-000d3afbc7d7"},{"cveNumber":"CVE-2026-70125","version":1.3,"revisionDate":"2026-10-30T07:00:00-07:00","initialDate":"0001-01-01T00:00:00Z","description":"<p>Updated one or more CVSS scores for the affected products. This is an informational change only.</p>\n","unformattedDescription":"Updated one or more CVSS scores for the affected products. This is an informational change only.","notificationNeeded":false,"notificationSent":false,"sourceId":"d7944b69-abd4-f111-a059-6045bd0a04e8"}]},{"id":"00000000-0000-0000-0000-0000b431b766","releaseDate":"2026-10-25T01:01:37-07:00","cveNumber":"CVE-2026-110354","cveTitle":"HAProxy 3 before 3.4.6 allows a remote unauthenticated attacker to cause a denial of service (persistent worker-thread CPU exhaustion) via an HTTP/1.1 chunked request. Although the H1 multiplexer drains the request before closing the stream, the parser repeatedly re-processes the same bytes without making progress. The affected thread stays busy at 100% CPU after timeouts expire and after the client disconnects, and repeated requests can consume all worker threads until the process is restarted.","releaseNumber":"2026-Oct","vulnType":"Security Vulnerability","latestRevisionDate":"2026-10-30T01:45:10-07:00","cweList":["CWE-835: Loop with Unreachable Exit Condition ('Infinite Loop')"],"cweDetailsListForSearch":["cwe: CWE-835: Loop with Unreachable Exit Condition ('Infinite Loop')","cweUrl: https://cwe.mitre.org/data/definitions/835.html"],"mitreText":"CVE-2026-110354","mitreUrl":"https://www.cve.org/CVERecord?id=CVE-2026-110354","latestSoftwareReleaseId":0,"olderSoftwareReleaseId":0,"denialOfService":"N/A","tag":"Marin