# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Python (in case helper scripts get added)
__pycache__/
*.pyc
.venv/
venv/

# Node (in case helper scripts get added)
node_modules/

# Local-only tool data
.cache/
.tmp/
*.log

# Local Pages build output (GitHub Action rebuilds from source)
site/_site/

# Sub-agent intermediate state — see prompts/{daily-cti-brief,weekly-summary}.md.
# Sub-agents persist partial work here so a later step that fails or times
# out can resume from the last good checkpoint. Never committed.
work/

# Local Claude / preview tooling
.claude/launch.json

# Claude Code worktrees (created on demand by `/worktree` and similar; never commit)
.claude/worktrees/

# Never commit secrets
.env
.env.*
*secret*
*credential*
