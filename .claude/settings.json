{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/setup-memory.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/setup-deps.sh",
            "timeout": 300,
            "async": true
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": true,
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "disableWorkflows": true,
  "skillOverrides": {
    "dataviz": "off",
    "keybindings-help": "off",
    "init": "off",
    "run": "off",
    "loop": "off",
    "workflow-authoring": "off",
    "fewer-permission-prompts": "off",
    "claude-api": "off",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only",
    "update-config": "user-invocable-only"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read(.claude/memory/**)",
      "Edit(.claude/memory/**)",
      "Read(./.claude/memory/**)",
      "Edit(./.claude/memory/**)",
      "Read(//home/user/ctipilot/.claude/memory/**)",
      "Edit(//home/user/ctipilot/.claude/memory/**)",
      "Read(**/.claude/memory/**)",
      "Edit(**/.claude/memory/**)",
      "Read(~/.claude/projects/**/memory/**)",
      "Edit(~/.claude/projects/**/memory/**)",
      "Bash(cat > .claude/memory/*)",
      "Bash(cat >> .claude/memory/*)",
      "Bash(cat > /home/user/ctipilot/.claude/memory/*)",
      "Bash(cat >> /home/user/ctipilot/.claude/memory/*)",
      "Bash(tee .claude/memory/*)",
      "Bash(tee -a .claude/memory/*)",
      "Bash(mkdir -p .claude/memory*)",
      "Bash(ls .claude/memory*)",
      "Bash(cat .claude/memory/*)",
      "Read(.claude/**)",
      "Edit(.claude/settings.json)",
      "Edit(//home/user/ctipilot/.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/agents/**)"
    ]
  }
}
